#!/usr/bin/env bash
# mux: per-project Neovim server launcher.
# Each project (git root) gets one `nvim --headless --listen <socket>` server
# (running the real config, with mux.lua activated via -c + MUX=1). Clients
# attach via `--remote-ui`; switch projects from inside nvim with `:connect`.
# Set MUX_APPNAME=mux for an isolated clean-room config instead.

set -euo pipefail

APP="${MUX_APPNAME:-}"
NVIM="${MUX_NVIM:-nvim}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mux"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/mux"
LAST_FILE="$STATE_DIR/last"
HISTORY_FILE="$STATE_DIR/history"

die() {
  printf 'mux: %s\n' "$1" >&2
  exit 1
}

command -v "$NVIM" >/dev/null 2>&1 || die "neovim ($NVIM) not found"

slug() {
  local path="$1" base hash
  base="$(basename "$path" | tr -c 'A-Za-z0-9._-' '_')"
  hash="$(printf '%s' "$path" | cksum | cut -d' ' -f1)"
  printf '%s-%s' "${base:-project}" "$hash"
}

root_for() {
  local path="$1"
  if git -C "$path" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$path" rev-parse --show-toplevel
  else
    realpath "$path"
  fi
}

socket_for() {
  printf '%s/%s.sock' "$RUNTIME_DIR" "$(slug "$1")"
}

is_live() {
  # </dev/null: keep the remote client off the tty so it doesn't init a TUI
  # (alt-screen + terminal queries) and pollute output (see `list`).
  "$NVIM" --server "$1" --remote-expr 1 </dev/null >/dev/null 2>&1
}

ensure() {
  local path root sock i
  path="${1:-$PWD}"
  root="$(root_for "$path")"
  sock="$(socket_for "$root")"
  mkdir -p "$RUNTIME_DIR"
  if [ -e "$sock" ] && ! is_live "$sock"; then
    rm -f "$sock" # stale socket left by a dead server (neovim#30123)
  fi
  if ! is_live "$sock"; then
    (
      cd "$root" || exit 1
      exec setsid env MUX=1 ${APP:+NVIM_APPNAME=$APP} "$NVIM" \
        --headless --listen "$sock" \
        -c "lua pcall(function() require('mux').setup() end)" \
        </dev/null >/dev/null 2>&1
    ) &
    i=0
    while [ "$i" -lt 100 ]; do
      if is_live "$sock"; then break; fi
      sleep 0.05
      i=$((i + 1))
    done
    is_live "$sock" || die "server did not start at $sock"
  fi
  printf '%s\n' "$sock"
}

# persist the project we last attached to (state dir, survives reboot); the
# in-nvim side records the same file on :connect (see mux.lua record_last).
record_last() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$LAST_FILE"
}

push_history() {
  local root="$1" tmp
  [ -n "$root" ] || return 0
  mkdir -p "$STATE_DIR"
  tmp="$(mktemp "$STATE_DIR/.history.XXXXXX")" || return 0
  if [ -f "$HISTORY_FILE" ]; then
    grep -vxF -- "$root" "$HISTORY_FILE" 2>/dev/null | tail -n 49 >>"$tmp" || true
  fi
  printf '%s\n' "$root" >>"$tmp"
  mv -f "$tmp" "$HISTORY_FILE"
}

attach() {
  local root sock
  root="$(root_for "${1:-$PWD}")"
  sock="$(ensure "$root")"
  record_last "$root"
  push_history "$root"
  cd "$root" || true
  env MUX=1 ${APP:+NVIM_APPNAME=$APP} "$NVIM" --remote-ui --server "$sock"
  exec "${SHELL:-/bin/sh}"
}

# bare `mux`: re-attach to the last project (spawning if its server died). With
# no recorded last, attach the sole live server if there's exactly one; else
# fall back to the `pick` fzf chooser.
resume() {
  local last lines n cwd
  last=""
  [ -f "$LAST_FILE" ] && last="$(head -n1 "$LAST_FILE" 2>/dev/null || true)"
  if [ -n "$last" ] && [ -d "$last" ]; then
    attach "$last"
    return
  fi
  lines="$(list)"
  n="$(printf '%s' "$lines" | grep -c . || true)"
  if [ "$n" -eq 1 ]; then
    cwd="$(printf '%s\n' "$lines" | head -n1 | cut -f1)"
    if [ -n "$cwd" ] && [ "$cwd" != '?' ] && [ -d "$cwd" ]; then
      attach "$cwd"
      return
    fi
  fi
  pick
}

list() {
  local sock cwd i w=0
  local cwds=() socks=()
  [ -d "$RUNTIME_DIR" ] || return 0
  for sock in "$RUNTIME_DIR"/*.sock; do
    [ -e "$sock" ] || continue
    if ! is_live "$sock"; then continue; fi
    cwd="$("$NVIM" --server "$sock" --remote-expr 'getcwd()' </dev/null 2>/dev/null || true)"
    cwds+=("${cwd:-?}")
    socks+=("$sock")
  done
  # Aligned columns for a terminal; raw cwd<TAB>socket when piped/captured so
  # `pick`, the in-nvim picker, and project cycling can still parse it.
  if [ -t 1 ]; then
    for cwd in "${cwds[@]}"; do [ "${#cwd}" -gt "$w" ] && w="${#cwd}"; done
    for i in "${!cwds[@]}"; do
      printf '%-*s  %s\n' "$w" "${cwds[$i]}" "${socks[$i]}"
    done
  else
    for i in "${!cwds[@]}"; do
      printf '%s\t%s\n' "${cwds[$i]}" "${socks[$i]}"
    done
  fi
}

# project candidates for the picker: live servers + zoxide history, ~-abbreviated
candidates() {
  {
    list | cut -f1
    zoxide query -l 2>/dev/null || true
  } | awk 'NF && $0 != "?" && !seen[$0]++' | sed "s|^$HOME|~|"
}

# fzf-pick a project and attach it
pick() {
  local choice
  choice="$(candidates | fzf --prompt 'project> ')" || return 0
  [ -n "$choice" ] || return 0
  attach "${choice/#\~/$HOME}"
}

usage() {
  cat <<'EOF'
mux: per-project neovim server launcher

  mux [<path>]        attach to the project at <path> (default: cwd), spawning if needed
  mux ensure [<path>] print a live server socket for the project, spawning if needed
  mux list            list running project servers (cwd<TAB>socket)
  mux pick            fzf-pick a project (live servers + zoxide) and attach
  mux candidates      print project candidates (live servers + zoxide)
  mux kill [<path>]   quit the project's server
  mux -h | --help     this help

Inside nvim, switch projects with:  :connect <socket>   (see `mux list`)
EOF
}

kill_server() {
  local sock
  sock="$(socket_for "$(root_for "${1:-$PWD}")")"
  if is_live "$sock"; then
    "$NVIM" --server "$sock" --remote-expr 'execute("qall!")' </dev/null >/dev/null 2>&1 || true
  fi
  rm -f "$sock"
}

case "${1:-}" in
ensure)
  shift
  ensure "${1:-$PWD}"
  ;;
list)
  list
  ;;
pick)
  pick
  ;;
candidates)
  candidates
  ;;
kill)
  shift
  kill_server "${1:-$PWD}"
  ;;
-h | --help)
  usage
  ;;
attach)
  shift
  attach "${1:-$PWD}"
  ;;
"")
  resume
  ;;
-*)
  die "unknown option: $1 (try --help)"
  ;;
*)
  attach "$1"
  ;;
esac
