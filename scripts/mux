#!/usr/bin/env bash
# mux: per-project Neovim server launcher.
# Each project (git root) gets one `nvim --headless --listen <socket>` server
# (running the real config, with mux.lua activated via -c + MUX=1). Clients
# attach via `--remote-ui`; switch projects from inside nvim with `:connect`.

set -euo pipefail

NVIM="${MUX_NVIM:-nvim}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mux"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/mux"
LAST_FILE="$STATE_DIR/last"
HISTORY_FILE="$STATE_DIR/history"

die() {
  printf 'mux: %s\n' "$1" >&2
  exit 1
}

command -v "$NVIM" >/dev/null 2>&1 || die "neovim ($NVIM) not found"

slug() {
  local path="$1" base hash
  base="$(basename "$path" | tr -c 'A-Za-z0-9._-' '_')"
  hash="$(printf '%s' "$path" | cksum | cut -d' ' -f1)"
  printf '%s-%s' "${base:-project}" "$hash"
}

root_for() {
  local path="$1"
  if git -C "$path" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$path" rev-parse --show-toplevel
  else
    realpath "$path"
  fi
}

socket_for() {
  printf '%s/%s.sock' "$RUNTIME_DIR" "$(slug "$1")"
}

session_for() {
  printf '%s/sessions/%s.vim' "$STATE_DIR" "$(slug "$1")"
}

is_live() {
  "$NVIM" --server "$1" --remote-expr 1 </dev/null >/dev/null 2>&1
}

ensure() {
  local path root sock i
  path="${1:-$PWD}"
  root="$(root_for "$path")"
  sock="$(socket_for "$root")"
  mkdir -p "$RUNTIME_DIR"
  if [ -e "$sock" ] && ! is_live "$sock"; then
    rm -f "$sock"
  fi
  if ! is_live "$sock"; then
    (
      cd "$root" || exit 1
      exec setsid env MUX=1 MUX_SESSION_FILE="$(session_for "$root")" "$NVIM" \
        --headless --listen "$sock" \
        -c "lua pcall(function() require('mux').setup() end)" \
        </dev/null >/dev/null 2>&1
    ) &
    i=0
    while [ "$i" -lt 100 ]; do
      if is_live "$sock"; then break; fi
      sleep 0.05
      i=$((i + 1))
    done
    is_live "$sock" || die "server did not start at $sock"
  fi
  printf '%s\n' "$sock"
}

record_last() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$LAST_FILE"
}

push_history() {
  local root="$1" tmp
  [ -n "$root" ] || return 0
  mkdir -p "$STATE_DIR"
  tmp="$(mktemp "$STATE_DIR/.history.XXXXXX")" || return 0
  if [ -f "$HISTORY_FILE" ]; then
    grep -vxF -- "$root" "$HISTORY_FILE" 2>/dev/null | tail -n 49 >>"$tmp" || true
  fi
  printf '%s\n' "$root" >>"$tmp"
  mv -f "$tmp" "$HISTORY_FILE"
}

forget_history() {
  local root="$1" tmp
  [ -n "$root" ] || return 0
  [ -f "$HISTORY_FILE" ] || return 0
  tmp="$(mktemp "$STATE_DIR/.history.XXXXXX")" || return 0
  grep -vxF -- "$root" "$HISTORY_FILE" 2>/dev/null >>"$tmp" || true
  mv -f "$tmp" "$HISTORY_FILE"
}

clear_last() {
  local root="$1" cur
  [ -f "$LAST_FILE" ] || return 0
  cur="$(head -n1 "$LAST_FILE" 2>/dev/null || true)"
  [ "$cur" = "$root" ] && rm -f "$LAST_FILE" || true
}

attach() {
  local root sock
  root="$(root_for "${1:-$PWD}")"
  sock="$(ensure "$root")"
  record_last "$root"
  push_history "$root"
  cd "$root" || true
  env MUX=1 "$NVIM" --remote-ui --server "$sock"
  exec "${SHELL:-/bin/sh}"
}

resume() {
  local last lines n cwd
  last=""
  [ -f "$LAST_FILE" ] && last="$(head -n1 "$LAST_FILE" 2>/dev/null || true)"
  if [ -n "$last" ] && [ -d "$last" ]; then
    attach "$last"
    return
  fi
  lines="$(list)"
  n="$(printf '%s' "$lines" | grep -c . || true)"
  if [ "$n" -eq 1 ]; then
    cwd="$(printf '%s\n' "$lines" | head -n1 | cut -f1)"
    if [ -n "$cwd" ] && [ "$cwd" != '?' ] && [ -d "$cwd" ]; then
      attach "$cwd"
      return
    fi
  fi
  pick
}

# List sessions: live servers (running) plus stopped ones (a saved snapshot
# exists, recovered from its `.root` sidecar). Machine output is one
# `cwd<TAB>socket<TAB>status` row per session (socket empty when stopped); a TTY
# gets a colored [live]/[stopped] tag, the ~-shortened path, and the socket.
list() {
  local sock cwd i w=0
  local cwds=() socks=() stats=() disp=()
  if [ -d "$RUNTIME_DIR" ]; then
    for sock in "$RUNTIME_DIR"/*.sock; do
      [ -e "$sock" ] || continue
      if ! is_live "$sock"; then continue; fi
      cwd="$("$NVIM" --server "$sock" --remote-expr 'getcwd()' </dev/null 2>/dev/null || true)"
      cwds+=("${cwd:-?}")
      socks+=("$sock")
      stats+=("live")
    done
  fi
  # stopped = snapshot+sidecar present but the project's server isn't live.
  if [ -d "$STATE_DIR/sessions" ]; then
    local rf root
    for rf in "$STATE_DIR"/sessions/*.root; do
      [ -e "$rf" ] || continue
      [ -f "${rf%.root}.vim" ] || continue
      root="$(head -n1 "$rf" 2>/dev/null || true)"
      [ -n "$root" ] && [ -d "$root" ] || continue
      if is_live "$(socket_for "$root")"; then continue; fi
      cwds+=("$root")
      socks+=("")
      stats+=("stopped")
    done
  fi
  if [ -t 1 ]; then
    local reset green amber c tag
    reset=$'\033[0m'
    green=$'\033[32m'
    amber=$'\033[33m'
    for cwd in "${cwds[@]}"; do disp+=("${cwd/#$HOME/\~}"); done
    for cwd in "${disp[@]}"; do [ "${#cwd}" -gt "$w" ] && w="${#cwd}"; done
    for i in "${!disp[@]}"; do
      if [ "${stats[$i]}" = live ]; then c="$green"; else c="$amber"; fi
      tag="$(printf '%-9s' "[${stats[$i]}]")"
      printf '%s%s%s %-*s  %s\n' "$c" "$tag" "$reset" "$w" "${disp[$i]}" "${socks[$i]}"
    done
  else
    for i in "${!cwds[@]}"; do
      printf '%s\t%s\t%s\n' "${cwds[$i]}" "${socks[$i]}" "${stats[$i]}"
    done
  fi
}

candidates() {
  {
    list | cut -f1
    zoxide query -l 2>/dev/null || true
  } | awk 'NF && $0 != "?" && !seen[$0]++' | sed "s|^$HOME|~|"
}

pick() {
  local choice
  choice="$(candidates | fzf --prompt 'project> ')" || return 0
  [ -n "$choice" ] || return 0
  attach "${choice/#\~/$HOME}"
}

usage() {
  cat <<'EOF'
mux: per-project neovim server launcher

  mux [<path>]        attach to the project at <path> (default: cwd), spawning if needed
  mux ensure [<path>] print a live server socket for the project, spawning if needed
  mux list            list sessions: live + stopped (cwd<TAB>socket<TAB>status)
  mux pick            fzf-pick a project (live servers + zoxide) and attach
  mux candidates      print project candidates (live servers + zoxide)
  mux stop [<path>]   stop the project's server (saved session restored next attach)
  mux kill [<path>]   hard-remove the project: stop + delete its saved session
  mux reload [<path>] reload the project in place (apply edited config)
  mux reload --all    reload every live session
  mux help            this help (also -h | --help)

Inside nvim, switch projects with:  :connect <socket>   (see `mux list`)
EOF
}

stop_server() {
  local sock
  sock="$(socket_for "$(root_for "${1:-$PWD}")")"
  if is_live "$sock"; then
    "$NVIM" --server "$sock" --remote-expr 'execute("qall!")' </dev/null >/dev/null 2>&1 || true
  fi
  rm -f "$sock"
}

kill_server() {
  local root sock sf i
  root="$(root_for "${1:-$PWD}")"
  sock="$(socket_for "$root")"
  sf="$(session_for "$root")"
  if is_live "$sock"; then
    # hard kill: set the in-Neovim no-save guard and quit, so VimLeavePre can't
    # re-save the snapshot we're about to delete.
    "$NVIM" --server "$sock" --remote-expr \
      "luaeval('(function() require([[mux]]).kill_session() return 1 end)()')" \
      </dev/null >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 100 ] && is_live "$sock"; do
      sleep 0.05
      i=$((i + 1))
    done
  fi
  rm -f "$sock" "$sf" "${sf%.vim}.root"
  forget_history "$root"
  clear_last "$root"
}

reload_one() {
  local root sock uis i
  root="$(root_for "${1:-$PWD}")"
  sock="$(socket_for "$root")"
  is_live "$sock" || return 0
  uis="$("$NVIM" --server "$sock" --remote-expr 'len(nvim_list_uis())' </dev/null 2>/dev/null || true)"
  uis="${uis//[^0-9]/}"
  if [ "${uis:-0}" -gt 0 ]; then
    "$NVIM" --server "$sock" --remote-expr \
      "luaeval('(function() require([[mux]]).reload() return 1 end)()')" \
      </dev/null >/dev/null 2>&1 || true
  else
    "$NVIM" --server "$sock" --remote-expr 'execute("silent! wall | qall!")' </dev/null >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 100 ] && is_live "$sock"; do
      sleep 0.05
      i=$((i + 1))
    done
    ensure "$root" >/dev/null
  fi
}

reload_all() {
  local sock cwd
  [ -d "$RUNTIME_DIR" ] || return 0
  for sock in "$RUNTIME_DIR"/*.sock; do
    [ -e "$sock" ] || continue
    is_live "$sock" || continue
    cwd="$("$NVIM" --server "$sock" --remote-expr 'getcwd()' </dev/null 2>/dev/null || true)"
    [ -n "$cwd" ] && reload_one "$cwd"
  done
}

case "${1:-}" in
ensure)
  shift
  ensure "${1:-$PWD}"
  ;;
list)
  list
  ;;
pick)
  pick
  ;;
candidates)
  candidates
  ;;
stop)
  shift
  stop_server "${1:-$PWD}"
  ;;
kill)
  shift
  kill_server "${1:-$PWD}"
  ;;
reload)
  shift
  if [ "${1:-}" = --all ] || [ "${1:-}" = -a ]; then
    reload_all
  else
    reload_one "${1:-$PWD}"
  fi
  ;;
help | -h | --help)
  usage
  ;;
attach)
  shift
  attach "${1:-$PWD}"
  ;;
"")
  resume
  ;;
-*)
  die "unknown option: $1 (try --help)"
  ;;
*)
  [ -d "$1" ] || die "unknown command: $1 (try --help)"
  attach "$1"
  ;;
esac
