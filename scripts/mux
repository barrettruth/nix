#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
mux: open a project in the Neovim mux

  mux [<path>]
  mux open [<path>]
EOF
}

case "${1:-}" in
-h | --help | help)
  usage
  exit 0
  ;;
open)
  shift
  ;;
esac

path="${1:-$PWD}"
if [ "$#" -eq 0 ]; then
  cur="$path"
  root=""
  while [ -n "$cur" ]; do
    if [ -e "$cur/.git" ] || [ -e "$cur/.jj" ]; then
      root="$cur"
      break
    fi
    parent="${cur%/*}"
    [ "$parent" != "$cur" ] || break
    [ -n "$parent" ] || parent="/"
    cur="$parent"
  done
  if [ -z "$root" ] && [ -d "$HOME/.config/nix" ]; then
    path="$HOME/.config/nix"
  fi
fi

MUX_OPEN_PATH="$path" exec nvim +'lua vim.defer_fn(function() vim.cmd.Mux(vim.env.MUX_OPEN_PATH or "") end, 50)'
