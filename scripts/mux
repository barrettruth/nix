#!/bin/sh

require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "mux: missing dependency: $cmd" >&2
      exit 1
    }
  done
}

require tmux

scope_from_root() {
  _root="$1"
  if [ "$_root" = "$HOME" ]; then
    printf '~'
  else
    basename "$_root"
  fi
}

get_root_from_path() {
  _path="$1"
  _root=$(git -C "$_path" rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$_root" ]; then
    printf '%s' "$_root"
  elif [ "$_path" = "$HOME" ]; then
    printf '%s' "$HOME"
  else
    printf '%s' "$_path"
  fi
}

get_managed_scope() {
  _name=$(tmux display-message -p '#{window_name}')
  case "$_name" in
  ai@* | code@* | shell@* | run@* | git@*)
    printf '%s' "${_name#*@}"
    ;;
  *)
    return 1
    ;;
  esac
}

get_root() {
  _scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$_scope" ]; then
    _root=$(tmux show-options -wgv @mux_root 2>/dev/null || true)
    if [ -n "$_root" ] && [ "$(scope_from_root "$_root")" = "$_scope" ]; then
      printf '%s' "$_root"
      return
    fi
    _path=$(tmux display-message -p '#{pane_start_path}')
  else
    _path=$(tmux display-message -p '#{pane_current_path}')
  fi
  get_root_from_path "$_path"
}

get_scope() {
  _scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$_scope" ]; then
    printf '%s' "$_scope"
  else
    scope_from_root "$(get_root)"
  fi
}

set_root() {
  _target="$1"
  _root="$2"
  if [ -n "$_target" ]; then
    tmux set-option -t "$_target" -w @mux_root "$_root"
  else
    tmux set-option -w @mux_root "$_root"
  fi
}

quote_sh() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

run_in_root() {
  _root="$1"
  _cmd="$2"
  [ -n "$_cmd" ] && printf "cd %s && %s" "$(quote_sh "$_root")" "$_cmd"
}

new_window_for_scope() {
  _name="$1"
  _root="$2"
  _idx=$(tmux new-window -P -F '#{window_index}' -c "$_root" -n "$_name")
  set_root ":${_idx}" "$_root"
  printf '%s' "$_idx"
}

is_adoptable() {
  _shell=$(basename "$SHELL")
  _name=$(tmux display-message -p '#{window_name}')
  _cmd=$(tmux display-message -p '#{pane_current_command}')
  _panes=$(tmux display-message -p '#{window_panes}')
  [ "$_panes" -eq 1 ] && [ "$_cmd" = "$_shell" ] && [ "$_name" = "$_shell" ]
}

is_pane_idle() {
  _target="${1:-}"
  _shell=$(basename "$SHELL")
  if [ -n "$_target" ]; then
    _pane_cmd=$(tmux display-message -t "$_target" -p '#{pane_current_command}')
  else
    _pane_cmd=$(tmux display-message -p '#{pane_current_command}')
  fi
  [ "$_pane_cmd" = "$_shell" ]
}

spawn_or_focus() {
  root=$(get_root)
  spawn_or_focus_in "$1" "$root" "$2"
}

spawn_or_focus_in() {
  type="$1"
  root="$2"
  scope=$(get_scope)
  if [ "$(scope_from_root "$root")" != "$scope" ]; then
    scope=$(scope_from_root "$root")
  fi
  name="${type}@${scope}"
  cmd="$3"

  idx=$(tmux list-windows -F '#{window_name}	#{window_index}' | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
  cur_idx=$(tmux display-message -p '#{window_index}')

  if [ -n "$idx" ] && [ "$idx" = "$cur_idx" ]; then
    if [ -n "$cmd" ] && is_pane_idle; then
      set_root "" "$root"
      tmux send-keys C-u C-l "$(run_in_root "$root" "$cmd")" Enter
    fi
  elif is_adoptable; then
    [ -n "$idx" ] && tmux kill-window -t ":${idx}"
    tmux rename-window "$name"
    set_root "" "$root"
    [ -n "$cmd" ] && tmux send-keys "$(run_in_root "$root" "$cmd")" Enter
  elif [ -n "$idx" ]; then
    tmux select-window -t ":${idx}"
    set_root ":${idx}" "$root"
    if [ -n "$cmd" ] && is_pane_idle ":${idx}"; then
      tmux send-keys -t ":${idx}" C-u C-l "$(run_in_root "$root" "$cmd")" Enter
    fi
  elif [ -n "$cmd" ]; then
    idx=$(new_window_for_scope "$name" "$root")
    tmux send-keys -t ":${idx}" "$cmd" Enter
  else
    new_window_for_scope "$name" "$root" >/dev/null
  fi
}

open_target() {
  open_target_in_root "$1" "$(get_root)"
}

open_target_in_root() {
  type="$1"
  root="$2"
  scope=$(scope_from_root "$root")

  case "$type" in
  ai)
    require devin
    spawn_or_focus_in ai "$root" 'devin'
    ;;
  code)
    require nvim
    spawn_or_focus_in code "$root" 'nvim .'
    ;;
  git)
    require nvim git
    if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      tmux display-message "Not a git repository"
    else
      spawn_or_focus_in git "$root" 'nvim -c "Git|only"'
    fi
    ;;
  run)
    case "$scope" in
    delta | barrettruth.com)
      spawn_or_focus_in run "$root" 'nix develop -c pnpm dev'
      ;;
    *)
      tmux display-message "mux: no run command for '$scope'"
      ;;
    esac
    ;;
  shell)
    spawn_or_focus_in shell "$root"
    ;;
  esac
}

show_picker() {
  _start_mode="${1:-open}"
  require fzf
  export _MF="${XDG_RUNTIME_DIR:-/tmp}/mux-picker-mode"
  printf '%s' "$_start_mode" >"$_MF"
  export _SCOPE=$(get_scope)
  export _SESSION=$(tmux display-message -p '#S')
  export _ACCENT=$(tmux show -gv @accent 2>/dev/null | tr -d '#')
  [ -z "$_ACCENT" ] && _ACCENT="7aa2f7"
  export _FGALT=$(tmux show -gv @fgAlt 2>/dev/null | tr -d '#')
  [ -z "$_FGALT" ] && _FGALT="666666"
  mux _list | fzf --reverse --ansi --no-info --no-scrollbar \
    --header "$(mux _header)" \
    --prompt "$(mux _prompt)" \
    --pointer '▌' \
    --color "header:#${_FGALT},prompt:#${_ACCENT},separator:#${_FGALT}" \
    --separator '' \
    --delimiter '\t' --with-nth 1 --accept-nth 2 \
    --bind "ctrl-o:execute-silent(mux _toggle proj)+reload(mux _list)+transform-header(mux _header)+transform-prompt(mux _prompt)" \
    --bind "enter:ignore" \
    --bind "ctrl-a:become(mux _picker_open ai {2})" \
    --bind "ctrl-c:become(mux _picker_open code {2})" \
    --bind "ctrl-s:become(mux _picker_open shell {2})" \
    --bind "ctrl-r:become(mux _picker_open run {2})" \
    --bind "ctrl-g:become(mux _picker_open git {2})" \
    --bind "ctrl-x:execute-silent(mux _dispatch kill:{2})+reload(mux _list)+transform-header(mux _header)"
}

case "$1" in
bar)
  if [ "$(tmux show-options -gv mouse)" = "on" ]; then
    indicator='#{?pane_in_mode,[mouse#{@c}copy],[mouse]}'
  else
    indicator='#{?pane_in_mode,[copy],}'
  fi
  set -f
  keys="H J K L"
  bar_content=""
  i=0
  total=$(tmux ls -F x | wc -l)
  for line in $(tmux ls -F '#{session_id}:#{session_name}'); do
    sid="${line%%:*}"
    sname="${line#*:}"
    if [ $i -lt 4 ]; then
      key=$(echo "$keys" | cut -d' ' -f $((i + 1)))
    elif [ $i -eq $((total - 1)) ]; then
      key='$'
    else
      key='?'
    fi
    star="#{?#{==:#S,$sname},#[fg=#{@accent}]*#[default],}"
    [ -n "$bar_content" ] && bar_content="$bar_content │ "
    bar_content="$bar_content#[range=session|${sid}]${star}$key#[fg=#{@accent}]:#[default]$sname#[norange]"
    i=$((i + 1))
  done
  set +f
  tmux set -g status-left-length 80
  tmux set -g status-right-length 80
  tmux set -g status-left ' '
  tmux set -g window-status-format '#[range=window|#{window_index}]#{?window_last_flag,#[fg=#{@accent}]-#[default],}#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-current-format '#[range=window|#{window_index}]#[fg=#{@accent}]*#[default]#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-separator ' │ '
  tmux set -g @bar-content "$indicator $bar_content "
  ;;
switch)
  session="$(tmux ls -F '#S' | tail -n "+$(($2 + 1))" | head -1)"
  tmux switch -t "$session"
  ;;
ai)
  open_target ai
  ;;
code)
  open_target code
  ;;
git)
  open_target git
  ;;
run)
  open_target run
  ;;
shell)
  open_target shell
  ;;
open)
  show_picker open
  ;;
projects)
  show_picker proj
  ;;
_prompt)
  _mode=$(cat "$_MF" 2>/dev/null || echo open)
  case "$_mode" in
  open) printf '@%s> ' "$_SCOPE" ;;
  *)    printf 'open> ' ;;
  esac
  ;;
_header)
  _h="${_ACCENT:-7aa2f7}"
  _ac=$(printf '\033[38;2;%d;%d;%dm' "0x${_h%????}" "0x$(printf '%.2s' "${_h#??}")" "0x${_h#????}")
  _rst=$(printf '\033[0m')
  _mode=$(cat "$_MF" 2>/dev/null || echo open)
  case "$_mode" in
  open)
    printf ':: %s^A%s ai %s^C%s code %s^S%s shell %s^R%s run %s^G%s git %s^X%s kill %s^O%s projects' \
      "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst"
    ;;
  *)
    printf ':: %s^A%s ai %s^C%s code %s^S%s shell %s^R%s run %s^G%s git %s^O%s windows' \
      "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst" "$_ac" "$_rst"
    ;;
  esac
  ;;
_list)
  _h="${_ACCENT:-7aa2f7}"
  _ac=$(printf '\033[38;2;%d;%d;%dm' "0x${_h%????}" "0x$(printf '%.2s' "${_h#??}")" "0x${_h#????}")
  _fa="${_FGALT:-666666}"
  _muted=$(printf '\033[38;2;%d;%d;%dm' "0x${_fa%????}" "0x$(printf '%.2s' "${_fa#??}")" "0x${_fa#????}")
  _rst=$(printf '\033[0m')
  _mode=$(cat "$_MF" 2>/dev/null || echo open)
  case "$_mode" in
  open)
    _windows=$(tmux list-windows -F '#{window_name}	#{window_index}')
    for _t in ai code shell run git; do
      _name="${_t}@${_SCOPE}"
      _idx=$(printf '%s\n' "$_windows" | awk -F'\t' -v n="$_name" '$1==n{print $2;exit}')
      if [ -n "$_idx" ]; then
        printf '%s%s%s %s*%s%s\topen:%s\n' "$_ac" "$_t" "$_rst" "$_muted" "$_idx" "$_rst" "$_t"
      else
        printf '%s\topen:%s\n' "$_t" "$_t"
      fi
    done
    ;;
  *)
    for _d in $(zoxide query -l 2>/dev/null); do
      [ -d "$_d/.git" ] || continue
      _name=$(basename "$_d")
      if [ "$_name" = "$_SCOPE" ]; then
        printf '%s%s%s\tproj:%s\n' "$_ac" "$_name" "$_rst" "$_d"
      else
        printf '%s\tproj:%s\n' "$_name" "$_d"
      fi
    done
    ;;
  esac
  ;;
_toggle)
  _cur=$(cat "$_MF" 2>/dev/null || echo open)
  if [ "$_cur" = "$2" ]; then
    printf open >"$_MF"
  else
    printf '%s' "$2" >"$_MF"
  fi
  ;;
_dispatch)
  _input="$2"
  _mode="${_input%%:*}"
  _action="${_input#*:}"
  case "$_mode" in
  open) exec mux "$_action" ;;
  proj)
    _type=code
    _dir="$_action"
    case "$_action" in
    ai:* | code:* | shell:* | run:* | git:*)
      _type="${_action%%:*}"
      _dir="${_action#*:}"
      ;;
    esac
    open_target_in_root "$_type" "$_dir"
    ;;
  kill)
    _submode="${_action%%:*}"
    _type="${_action#*:}"
    case "$_submode" in
    open)
      _name="${_type}@${_SCOPE}"
      tmux kill-window -t "=$_name" 2>/dev/null
      ;;
    esac
    ;;
  esac
  ;;
_picker_open)
  _type="$2"
  _input="$3"
  _mode=$(cat "$_MF" 2>/dev/null || echo open)
  case "$_mode" in
  open)
    exec mux "$_type"
    ;;
  *)
    _submode="${_input%%:*}"
    _dir="${_input#*:}"
    [ "$_submode" = "proj" ] && open_target_in_root "$_type" "$_dir"
    ;;
  esac
  ;;
*)
  tmux attach 2>/dev/null || tmux new-session
  ;;
esac
