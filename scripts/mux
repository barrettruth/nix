#!/bin/sh

require() {
  for rq_cmd in "$@"; do
    command -v "$rq_cmd" >/dev/null 2>&1 || {
      echo "mux: missing dependency: $rq_cmd" >&2
      exit 1
    }
  done
}

require tmux

scope_from_root() {
  sfr_root="$1"
  if [ "$sfr_root" = "$HOME" ]; then
    printf '~'
  else
    basename "$sfr_root"
  fi
}

get_root_from_path() {
  grfp_path="$1"
  grfp_root=$(git -C "$grfp_path" rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$grfp_root" ]; then
    printf '%s' "$grfp_root"
  elif [ "$grfp_path" = "$HOME" ]; then
    printf '%s' "$HOME"
  else
    printf '%s' "$grfp_path"
  fi
}

get_managed_scope() {
  gms_scope=$(tmux show-options -wgv @mux_scope 2>/dev/null || true)
  if [ -n "$gms_scope" ]; then
    printf '%s' "$gms_scope"
    return
  fi

  gms_root=$(tmux show-options -wgv @mux_root 2>/dev/null || true)
  [ -n "$gms_root" ] || return 1

  gms_name=$(tmux display-message -p '#{window_name}')
  case "$gms_name" in
  *@*)
    printf '%s' "${gms_name#*@}"
    ;;
  *)
    return 1
    ;;
  esac
}

get_root() {
  gr_scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$gr_scope" ]; then
    gr_root=$(tmux show-options -wgv @mux_root 2>/dev/null || true)
    if [ -n "$gr_root" ] && [ "$(scope_from_root "$gr_root")" = "$gr_scope" ]; then
      printf '%s' "$gr_root"
      return
    fi
    gr_path=$(tmux display-message -p '#{pane_start_path}')
  else
    gr_path=$(tmux display-message -p '#{pane_current_path}')
  fi
  get_root_from_path "$gr_path"
}

get_scope() {
  gs_scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$gs_scope" ]; then
    printf '%s' "$gs_scope"
  else
    scope_from_root "$(get_root)"
  fi
}

set_window_option() {
  swo_target="$1"
  swo_name="$2"
  swo_value="$3"
  if [ -n "$swo_target" ]; then
    tmux set-option -t "$swo_target" -w "$swo_name" "$swo_value"
  else
    tmux set-option -w "$swo_name" "$swo_value"
  fi
}

set_root() {
  set_window_option "$1" @mux_root "$2"
}

set_window_meta() {
  swm_target="$1"
  swm_kind="$2"
  swm_name="$3"
  swm_scope="$4"
  swm_root="$5"
  swm_policy="$6"
  set_window_option "$swm_target" @mux_kind "$swm_kind"
  set_window_option "$swm_target" @mux_name "$swm_name"
  set_window_option "$swm_target" @mux_scope "$swm_scope"
  set_window_option "$swm_target" @mux_root "$swm_root"
  set_window_option "$swm_target" @mux_policy "$swm_policy"
}

quote_sh() {
  qs_input="$1"
  printf "'%s'" "$(printf '%s' "$qs_input" | sed "s/'/'\\\\''/g")"
}

run_in_root() {
  rir_root="$1"
  rir_cmd="$2"
  [ -n "$rir_cmd" ] && printf "cd %s && %s" "$(quote_sh "$rir_root")" "$rir_cmd"
}

shell_path() {
  printf '%s' "${SHELL:-/bin/sh}"
}

initial_shell_command() {
  isc_channel="${1:-}"
  isc_shell=$(shell_path)
  if [ -n "$isc_channel" ]; then
    printf "exec env PURE_FIX=0 MUX_READY_CHANNEL=%s %s -i" "$(quote_sh "$isc_channel")" "$(quote_sh "$isc_shell")"
  else
    printf "exec env PURE_FIX=0 %s -i" "$(quote_sh "$isc_shell")"
  fi
}

close_action_command() {
  cac_root="$1"
  cac_cmd="$2"
  cac_shell=$(shell_path)
  cac_payload=$(run_in_root "$cac_root" "$cac_cmd")
  printf "exec env PURE_FIX=0 %s -ic %s" "$(quote_sh "$cac_shell")" "$(quote_sh "$cac_payload")"
}

keep_on_fail_action_command() {
  kof_root="$1"
  kof_cmd="$2"
  kof_shell=$(shell_path)
  kof_payload="$(run_in_root "$kof_root" "$kof_cmd"); kof_status=\$?; if [ \"\$kof_status\" -eq 0 ]; then tmux kill-window -t \"\$TMUX_PANE\"; exit 0; fi; exec env PURE_FIX=0 $(quote_sh "$kof_shell") -i"
  printf "exec env PURE_FIX=0 %s -ic %s" "$(quote_sh "$kof_shell")" "$(quote_sh "$kof_payload")"
}

new_ready_channel() {
  printf 'mux-ready-%s-%s' "$$" "$(date +%s%N)"
}

window_name_for() {
  wnf_name="$1"
  wnf_scope="$2"
  printf '%s@%s' "$wnf_name" "$wnf_scope"
}

window_index_for_name() {
  wifn_name="$1"
  tmux list-windows -F '#{window_name}	#{window_index}' | awk -F'\t' -v n="$wifn_name" '$1 == n { print $2; exit }'
}

current_window_index() {
  tmux display-message -p '#{window_index}'
}

pane_path() {
  pp_target="${1:-}"
  if [ -n "$pp_target" ]; then
    tmux display-message -t "$pp_target" -p '#{pane_current_path}'
  else
    tmux display-message -p '#{pane_current_path}'
  fi
}

pane_command() {
  pc_target="${1:-}"
  if [ -n "$pc_target" ]; then
    tmux display-message -t "$pc_target" -p '#{pane_current_command}'
  else
    tmux display-message -p '#{pane_current_command}'
  fi
}

command_for_pane() {
  cfp_target="$1"
  cfp_root="$2"
  cfp_cmd="$3"
  cfp_path=$(pane_path "$cfp_target")
  if [ "$cfp_path" = "$cfp_root" ]; then
    printf '%s' "$cfp_cmd"
  else
    run_in_root "$cfp_root" "$cfp_cmd"
  fi
}

send_cmd() {
  sc_target="$1"
  sc_root="$2"
  sc_cmd="$3"
  if [ -n "$sc_target" ]; then
    tmux send-keys -t "$sc_target" C-u C-l "$(command_for_pane "$sc_target" "$sc_root" "$sc_cmd")" Enter
  else
    tmux send-keys C-u C-l "$(command_for_pane "" "$sc_root" "$sc_cmd")" Enter
  fi
}

send_initial_cmd() {
  sic_target="$1"
  sic_root="$2"
  sic_cmd="$3"
  if [ -n "$sic_target" ]; then
    tmux send-keys -t "$sic_target" "$(command_for_pane "$sic_target" "$sic_root" "$sic_cmd")" Enter
  else
    tmux send-keys "$(command_for_pane "" "$sic_root" "$sic_cmd")" Enter
  fi
}

schedule_initial_cmd() {
  scd_target="$1"
  scd_cmd="$2"
  scd_channel="${3:-}"
  if [ -n "$scd_channel" ]; then
    scd_payload="tmux wait-for $(quote_sh "$scd_channel"); tmux send-keys -t $(quote_sh "$scd_target") $(quote_sh "$scd_cmd") Enter"
  else
    scd_payload="tmux send-keys -t $(quote_sh "$scd_target") $(quote_sh "$scd_cmd") Enter"
  fi
  tmux run-shell -b "$scd_payload"
}

window_index_from_info() {
  wifi_info="$1"
  wifi_tab=$(printf '\t')
  printf '%s' "${wifi_info%%"$wifi_tab"*}"
}

pane_id_from_info() {
  pifi_info="$1"
  pifi_tab=$(printf '\t')
  printf '%s' "${pifi_info#*"$pifi_tab"}"
}

new_window_info_for_scope() {
  nwifs_window_name="$1"
  nwifs_root="$2"
  nwifs_cmd="${3:-}"
  nwifs_kind="$4"
  nwifs_name="$5"
  nwifs_policy="$6"
  nwifs_scope=$(scope_from_root "$nwifs_root")
  nwifs_fmt=$(printf '#{window_index}\t#{pane_id}')
  if [ -n "$nwifs_cmd" ]; then
    nwifs_info=$(tmux new-window -P -F "$nwifs_fmt" -c "$nwifs_root" -n "$nwifs_window_name" "$nwifs_cmd")
  else
    nwifs_info=$(tmux new-window -P -F "$nwifs_fmt" -c "$nwifs_root" -n "$nwifs_window_name")
  fi
  nwifs_idx=$(window_index_from_info "$nwifs_info")
  set_window_meta ":${nwifs_idx}" "$nwifs_kind" "$nwifs_name" "$nwifs_scope" "$nwifs_root" "$nwifs_policy"
  printf '%s' "$nwifs_info"
}

new_window_for_scope() {
  nwfs_info=$(new_window_info_for_scope "$@")
  window_index_from_info "$nwfs_info"
}

is_adoptable() {
  ia_shell=$(basename "$SHELL")
  ia_name=$(tmux display-message -p '#{window_name}')
  ia_cmd=$(pane_command)
  ia_panes=$(tmux display-message -p '#{window_panes}')
  [ "$ia_panes" -eq 1 ] && [ "$ia_cmd" = "$ia_shell" ] && [ "$ia_name" = "$ia_shell" ]
}

is_pane_idle() {
  ipi_target="${1:-}"
  ipi_shell=$(basename "$SHELL")
  ipi_pane_cmd=$(pane_command "$ipi_target")
  [ "$ipi_pane_cmd" = "$ipi_shell" ]
}

spawn_or_focus_managed() {
  sofm_kind="$1"
  sofm_name="$2"
  sofm_root="$3"
  sofm_cmd="${4:-}"
  sofm_policy="${5:-keep}"
  sofm_scope=$(scope_from_root "$sofm_root")
  sofm_window_name=$(window_name_for "$sofm_name" "$sofm_scope")
  sofm_idx=$(window_index_for_name "$sofm_window_name")
  sofm_cur_idx=$(current_window_index)

  if [ -n "$sofm_idx" ] && [ "$sofm_idx" = "$sofm_cur_idx" ]; then
    set_window_meta "" "$sofm_kind" "$sofm_name" "$sofm_scope" "$sofm_root" "$sofm_policy"
    if [ -n "$sofm_cmd" ] && is_pane_idle; then
      send_cmd "" "$sofm_root" "$sofm_cmd"
    fi
    return
  fi

  if is_adoptable; then
    [ -n "$sofm_idx" ] && tmux kill-window -t ":${sofm_idx}"
    tmux rename-window "$sofm_window_name"
    set_window_meta "" "$sofm_kind" "$sofm_name" "$sofm_scope" "$sofm_root" "$sofm_policy"
    [ -n "$sofm_cmd" ] && send_cmd "" "$sofm_root" "$sofm_cmd"
    return
  fi

  if [ -n "$sofm_idx" ]; then
    tmux select-window -t ":${sofm_idx}"
    set_window_meta ":${sofm_idx}" "$sofm_kind" "$sofm_name" "$sofm_scope" "$sofm_root" "$sofm_policy"
    if [ -n "$sofm_cmd" ] && is_pane_idle ":${sofm_idx}"; then
      send_cmd ":${sofm_idx}" "$sofm_root" "$sofm_cmd"
    fi
    return
  fi

  if [ -n "$sofm_cmd" ]; then
    sofm_channel=$(new_ready_channel)
    sofm_info=$(new_window_info_for_scope "$sofm_window_name" "$sofm_root" "$(initial_shell_command "$sofm_channel")" "$sofm_kind" "$sofm_name" "$sofm_policy")
    sofm_pane=$(pane_id_from_info "$sofm_info")
    schedule_initial_cmd "$sofm_pane" "$sofm_cmd" "$sofm_channel"
    return
  fi

  new_window_for_scope "$sofm_window_name" "$sofm_root" "" "$sofm_kind" "$sofm_name" "$sofm_policy" >/dev/null
}

spawn_action_close() {
  sac_name="$1"
  sac_root="$2"
  sac_cmd="$3"
  sac_scope=$(scope_from_root "$sac_root")
  sac_window_name=$(window_name_for "$sac_name" "$sac_scope")
  new_window_for_scope "$sac_window_name" "$sac_root" "$(close_action_command "$sac_root" "$sac_cmd")" action "$sac_name" close >/dev/null
}

spawn_action_keep_on_fail() {
  sakof_name="$1"
  sakof_root="$2"
  sakof_cmd="$3"
  sakof_scope=$(scope_from_root "$sakof_root")
  sakof_window_name=$(window_name_for "$sakof_name" "$sakof_scope")
  new_window_for_scope "$sakof_window_name" "$sakof_root" "$(keep_on_fail_action_command "$sakof_root" "$sakof_cmd")" action "$sakof_name" keep_on_fail >/dev/null
}

role_command_for() {
  rcf_name="$1"
  case "$rcf_name" in
  ai)
    printf 'devin'
    ;;
  dev)
    printf 'nvim .'
    ;;
  shell)
    :
    ;;
  *)
    return 1
    ;;
  esac
}

require_role_dependencies() {
  rrd_name="$1"
  case "$rrd_name" in
  ai)
    require devin
    ;;
  dev)
    require nvim
    ;;
  shell)
    :
    ;;
  esac
}

legacy_run_command_for_scope() {
  lrcfs_scope="$1"
  case "$lrcfs_scope" in
  neovim)
    printf 'make'
    ;;
  tmux)
    printf 'make -j "$(nproc)" -C build'
    ;;
  delta)
    printf 'nix develop -c pnpm dev'
    ;;
  barrettruth.com)
    printf 'pnpm dev'
    ;;
  *)
    return 1
    ;;
  esac
}

build_command_for_scope() {
  bcfs_scope="$1"
  case "$bcfs_scope" in
  tmux)
    printf 'make -j "$(nproc)" -C build'
    ;;
  *)
    return 1
    ;;
  esac
}

action_policy_for() {
  apf_name="$1"
  case "$apf_name" in
  git)
    printf 'close'
    ;;
  run | build)
    printf 'keep'
    ;;
  *)
    return 1
    ;;
  esac
}

action_command_for_root() {
  acfr_name="$1"
  acfr_root="$2"
  acfr_scope=$(scope_from_root "$acfr_root")
  case "$acfr_name" in
  git)
    printf 'nvim -c "Git|only"'
    ;;
  run)
    legacy_run_command_for_scope "$acfr_scope"
    ;;
  build)
    build_command_for_scope "$acfr_scope"
    ;;
  *)
    return 1
    ;;
  esac
}

list_action_names_for_root() {
  lafr_root="$1"
  printf 'git\n'
  if action_command_for_root run "$lafr_root" >/dev/null 2>&1; then
    printf 'run\n'
  fi
  if action_command_for_root build "$lafr_root" >/dev/null 2>&1; then
    printf 'build\n'
  fi
}

open_role() {
  open_role_in_root "$1" "$(get_root)"
}

open_role_in_root() {
  orir_name="$1"
  orir_root="$2"

  require_role_dependencies "$orir_name"

  if ! orir_cmd=$(role_command_for "$orir_name"); then
    tmux display-message "mux: unknown role '$orir_name'"
    return 1
  fi

  spawn_or_focus_managed role "$orir_name" "$orir_root" "$orir_cmd" keep
}

open_action() {
  open_action_in_root "$1" "$(get_root)"
}

open_action_in_root() {
  oair_name="$1"
  oair_root="$2"
  oair_scope=$(scope_from_root "$oair_root")

  case "$oair_name" in
  git)
    if ! git -C "$oair_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      tmux display-message "Not a git repository"
      return 1
    fi
    ;;
  esac

  if ! oair_cmd=$(action_command_for_root "$oair_name" "$oair_root"); then
    tmux display-message "mux: no action '$oair_name' for '$oair_scope'"
    return 1
  fi

  if ! oair_policy=$(action_policy_for "$oair_name"); then
    tmux display-message "mux: bad policy for '$oair_name'"
    return 1
  fi

  case "$oair_policy" in
  keep)
    spawn_or_focus_managed action "$oair_name" "$oair_root" "$oair_cmd" "$oair_policy"
    ;;
  close)
    spawn_action_close "$oair_name" "$oair_root" "$oair_cmd"
    ;;
  keep_on_fail)
    spawn_action_keep_on_fail "$oair_name" "$oair_root" "$oair_cmd"
    ;;
  *)
    tmux display-message "mux: bad policy '$oair_policy' for '$oair_name'"
    return 1
    ;;
  esac
}

picker_mode() {
  cat "$_MF" 2>/dev/null || echo open
}

set_picker_mode() {
  spm_mode="$1"
  printf '%s' "$spm_mode" >"$_MF"
}

color_escape() {
  ce_hex="$1"
  printf '\033[38;2;%d;%d;%dm' "0x${ce_hex%????}" "0x$(printf '%.2s' "${ce_hex#??}")" "0x${ce_hex#????}"
}

show_picker() {
  sp_start_mode="${1:-open}"
  require fzf
  _MF="${XDG_RUNTIME_DIR:-/tmp}/mux-picker-mode"
  export _MF
  set_picker_mode "$sp_start_mode"
  _ROOT=$(get_root)
  export _ROOT
  _SCOPE=$(scope_from_root "$_ROOT")
  export _SCOPE
  _ACCENT=$(tmux show -gv @accent 2>/dev/null | tr -d '#')
  [ -n "$_ACCENT" ] || _ACCENT='7aa2f7'
  export _ACCENT
  _FGALT=$(tmux show -gv @fgAlt 2>/dev/null | tr -d '#')
  [ -n "$_FGALT" ] || _FGALT='666666'
  export _FGALT
  mux _list | fzf --reverse --ansi --no-info --no-scrollbar \
    --header "$(mux _header)" \
    --prompt "$(mux _prompt)" \
    --pointer '▌' \
    --color "header:#${_FGALT},prompt:#${_ACCENT},separator:#${_FGALT}" \
    --separator '' \
    --delimiter '\t' --with-nth 1 --accept-nth 2 \
    --bind "ctrl-o:execute-silent(mux _toggle proj)+reload(mux _list)+transform-header(mux _header)+transform-prompt(mux _prompt)" \
    --bind "enter:become(mux _dispatch {2})" \
    --bind "ctrl-a:become(mux _picker_open role ai {2})" \
    --bind "ctrl-d:become(mux _picker_open role dev {2})" \
    --bind "ctrl-s:become(mux _picker_open role shell {2})" \
    --bind "ctrl-r:become(mux _picker_open action run {2})" \
    --bind "ctrl-g:become(mux _picker_open action git {2})" \
    --bind "ctrl-x:execute-silent(mux _dispatch kill:{2})+reload(mux _list)+transform-header(mux _header)"
}

picker_prompt() {
  ppr_mode=$(picker_mode)
  case "$ppr_mode" in
  open)
    printf '@%s> ' "$_SCOPE"
    ;;
  *)
    printf 'open> '
    ;;
  esac
}

picker_header() {
  ph_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  ph_rst=$(printf '\033[0m')
  ph_mode=$(picker_mode)
  case "$ph_mode" in
  open)
    printf ':: %s^A%s ai %s^D%s dev %s^S%s shell %s^R%s run %s^G%s git %s^X%s kill %s^O%s projects' \
      "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst"
    ;;
  *)
    printf ':: %s^A%s ai %s^D%s dev %s^S%s shell %s^R%s run %s^G%s git %s^O%s windows' \
      "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst"
    ;;
  esac
}

format_open_entry() {
  foe_label="$1"
  foe_token="$2"
  foe_window_name="${3:-}"
  foe_policy="${4:-}"
  foe_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  foe_muted=$(color_escape "${_FGALT:-666666}")
  foe_rst=$(printf '\033[0m')
  foe_idx=""

  if [ -n "$foe_window_name" ]; then
    foe_idx=$(window_index_for_name "$foe_window_name")
  fi

  foe_suffix=""
  [ -n "$foe_policy" ] && foe_suffix=" ${foe_muted}[${foe_policy}]${foe_rst}"

  if [ -n "$foe_idx" ]; then
    printf '%s%s%s%s %s*%s%s\t%s\n' "$foe_ac" "$foe_label" "$foe_rst" "$foe_suffix" "$foe_muted" "$foe_idx" "$foe_rst" "$foe_token"
  else
    printf '%s%s%s\t%s\n' "$foe_label" "$foe_suffix" "$foe_rst" "$foe_token"
  fi
}

list_open_entries() {
  for loe_role in ai dev shell; do
    loe_window_name=$(window_name_for "$loe_role" "$_SCOPE")
    format_open_entry "$loe_role" "role:$loe_role" "$loe_window_name"
  done

  list_action_names_for_root "$_ROOT" | while IFS= read -r loe_action; do
    [ -n "$loe_action" ] || continue
    if ! loe_policy=$(action_policy_for "$loe_action"); then
      continue
    fi
    loe_window_name=""
    [ "$loe_policy" = keep ] && loe_window_name=$(window_name_for "$loe_action" "$_SCOPE")
    format_open_entry "$loe_action" "action:$loe_action" "$loe_window_name" "$loe_policy"
  done
}

list_project_entries() {
  lpe_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  lpe_rst=$(printf '\033[0m')
  lpe_projects=$(zoxide query -l 2>/dev/null || true)
  [ -n "$lpe_projects" ] || return 0
  while IFS= read -r lpe_dir; do
    [ -n "$lpe_dir" ] || continue
    lpe_root=$(git -C "$lpe_dir" rev-parse --show-toplevel 2>/dev/null || true)
    [ "$lpe_root" = "$lpe_dir" ] || continue
    lpe_name=$(basename "$lpe_dir")
    if [ "$lpe_name" = "$_SCOPE" ]; then
      printf '%s%s%s\tproj:%s\n' "$lpe_ac" "$lpe_name" "$lpe_rst" "$lpe_dir"
    else
      printf '%s\tproj:%s\n' "$lpe_name" "$lpe_dir"
    fi
  done <<EOF2
$lpe_projects
EOF2
}

picker_list() {
  pl_mode=$(picker_mode)
  case "$pl_mode" in
  open)
    list_open_entries
    ;;
  *)
    list_project_entries
    ;;
  esac
}

toggle_picker_mode() {
  tpm_target_mode="$1"
  tpm_mode=$(picker_mode)
  if [ "$tpm_mode" = "$tpm_target_mode" ]; then
    set_picker_mode open
  else
    set_picker_mode "$tpm_target_mode"
  fi
}

kill_picker_target() {
  kpt_input="$1"
  kpt_kind=${kpt_input%%:*}
  kpt_name=${kpt_input#*:}
  kpt_window_name=$(window_name_for "$kpt_name" "$_SCOPE")
  case "$kpt_kind" in
  role | action)
    tmux kill-window -t "=$kpt_window_name" 2>/dev/null
    ;;
  esac
}

dispatch_picker_action() {
  dpa_input="$1"
  dpa_mode=${dpa_input%%:*}
  dpa_rest=${dpa_input#*:}
  case "$dpa_mode" in
  role)
    exec mux role "$dpa_rest"
    ;;
  action)
    exec mux action "$dpa_rest"
    ;;
  proj)
    open_role_in_root dev "$dpa_rest"
    ;;
  kill)
    kill_picker_target "$dpa_rest"
    ;;
  esac
}

picker_open_target() {
  pot_kind="$1"
  pot_name="$2"
  pot_input="$3"
  pot_mode=$(picker_mode)
  case "$pot_mode" in
  open)
    case "$pot_kind" in
    role)
      exec mux role "$pot_name"
      ;;
    action)
      exec mux action "$pot_name"
      ;;
    esac
    ;;
  *)
    pot_submode=${pot_input%%:*}
    pot_dir=${pot_input#*:}
    [ "$pot_submode" = proj ] || return
    case "$pot_kind" in
    role)
      open_role_in_root "$pot_name" "$pot_dir"
      ;;
    action)
      open_action_in_root "$pot_name" "$pot_dir"
      ;;
    esac
    ;;
  esac
}

session_key() {
  sk_index="$1"
  sk_total="$2"
  case "$sk_index" in
  0)
    printf 'H'
    ;;
  1)
    printf 'J'
    ;;
  2)
    printf 'K'
    ;;
  3)
    printf 'L'
    ;;
  *)
    if [ "$sk_index" -eq "$((sk_total - 1))" ]; then
      printf '$'
    else
      printf '?'
    fi
    ;;
  esac
}

render_bar() {
  if [ "$(tmux show-options -gv mouse)" = on ]; then
    rb_indicator='#{?pane_in_mode,[mouse#{@c}copy],[mouse]}'
  else
    rb_indicator='#{?pane_in_mode,[copy],}'
  fi

  rb_sessions=$(tmux ls -F '#{session_id}	#{session_name}')
  rb_bar_content=''

  if [ -n "$rb_sessions" ]; then
    rb_tab=$(printf '\t')
    rb_total=$(printf '%s\n' "$rb_sessions" | wc -l | tr -d ' ')
    rb_index=0

    while IFS= read -r rb_line; do
      [ -n "$rb_line" ] || continue
      rb_sid=${rb_line%%"${rb_tab}"*}
      rb_sname=${rb_line#*"${rb_tab}"}
      rb_key=$(session_key "$rb_index" "$rb_total")
      rb_star="#{?#{==:#S,$rb_sname},#[fg=#{@accent}]*#[default],}"
      [ -n "$rb_bar_content" ] && rb_bar_content="$rb_bar_content │ "
      rb_bar_content="$rb_bar_content#[range=session|${rb_sid}]${rb_star}${rb_key}#[fg=#{@accent}]:#[default]${rb_sname}#[norange]"
      rb_index=$((rb_index + 1))
    done <<EOF2
$rb_sessions
EOF2
  fi

  tmux set -g status-left-length 80
  tmux set -g status-right-length 80
  tmux set -g status-left ' '
  tmux set -g window-status-format '#[range=window|#{window_index}]#{?window_last_flag,#[fg=#{@accent}]-#[default],}#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-current-format '#[range=window|#{window_index}]#[fg=#{@accent}]*#[default]#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-separator ' │ '
  tmux set -g @bar-content "$rb_indicator $rb_bar_content "
}

switch_session() {
  ss_slot="$1"
  ss_session=$(tmux ls -F '#S' | sed -n "$((ss_slot + 1))p")
  [ -n "$ss_session" ] && tmux switch -t "$ss_session"
}

main() {
  case "${1:-}" in
  bar)
    render_bar
    ;;
  switch)
    switch_session "$2"
    ;;
  role)
    open_role "$2"
    ;;
  action)
    open_action "$2"
    ;;
  ai | dev | shell)
    open_role "$1"
    ;;
  code)
    printf 'mux: unknown role: code\n' >&2
    exit 1
    ;;
  git)
    open_action git
    ;;
  run)
    open_action "${2:-run}"
    ;;
  open)
    show_picker open
    ;;
  projects)
    show_picker proj
    ;;
  _prompt)
    picker_prompt
    ;;
  _header)
    picker_header
    ;;
  _list)
    picker_list
    ;;
  _toggle)
    toggle_picker_mode "$2"
    ;;
  _dispatch)
    dispatch_picker_action "$2"
    ;;
  _picker_open)
    picker_open_target "$2" "$3" "$4"
    ;;
  *)
    tmux attach 2>/dev/null || tmux new-session
    ;;
  esac
}

main "$@"
