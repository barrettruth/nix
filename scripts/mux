#!/bin/sh

require() {
  for rq_cmd in "$@"; do
    command -v "$rq_cmd" >/dev/null 2>&1 || {
      echo "mux: missing dependency: $rq_cmd" >&2
      exit 1
    }
  done
}

require tmux

scope_from_root() {
  sfr_root="$1"
  if [ "$sfr_root" = "$HOME" ]; then
    printf '~'
  else
    basename "$sfr_root"
  fi
}

get_root_from_path() {
  grfp_path="$1"
  grfp_root=$(git -C "$grfp_path" rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$grfp_root" ]; then
    printf '%s' "$grfp_root"
  elif [ "$grfp_path" = "$HOME" ]; then
    printf '%s' "$HOME"
  else
    printf '%s' "$grfp_path"
  fi
}

get_managed_scope() {
  gms_name=$(tmux display-message -p '#{window_name}')
  case "$gms_name" in
  ai@* | code@* | shell@* | run@* | git@*)
    printf '%s' "${gms_name#*@}"
    ;;
  *)
    return 1
    ;;
  esac
}

get_root() {
  gr_scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$gr_scope" ]; then
    gr_root=$(tmux show-options -wgv @mux_root 2>/dev/null || true)
    if [ -n "$gr_root" ] && [ "$(scope_from_root "$gr_root")" = "$gr_scope" ]; then
      printf '%s' "$gr_root"
      return
    fi
    gr_path=$(tmux display-message -p '#{pane_start_path}')
  else
    gr_path=$(tmux display-message -p '#{pane_current_path}')
  fi
  get_root_from_path "$gr_path"
}

get_scope() {
  gs_scope=$(get_managed_scope 2>/dev/null || true)
  if [ -n "$gs_scope" ]; then
    printf '%s' "$gs_scope"
  else
    scope_from_root "$(get_root)"
  fi
}

set_root() {
  sr_target="$1"
  sr_root="$2"
  if [ -n "$sr_target" ]; then
    tmux set-option -t "$sr_target" -w @mux_root "$sr_root"
  else
    tmux set-option -w @mux_root "$sr_root"
  fi
}

quote_sh() {
  qs_input="$1"
  printf "'%s'" "$(printf '%s' "$qs_input" | sed "s/'/'\\\\''/g")"
}

run_in_root() {
  rir_root="$1"
  rir_cmd="$2"
  [ -n "$rir_cmd" ] && printf "cd %s && %s" "$(quote_sh "$rir_root")" "$rir_cmd"
}

shell_path() {
  printf '%s' "${SHELL:-/bin/sh}"
}

initial_shell_command() {
  isc_channel="${1:-}"
  isc_shell=$(shell_path)
  if [ -n "$isc_channel" ]; then
    printf "exec env PURE_FIX=0 MUX_READY_CHANNEL=%s %s -i" "$(quote_sh "$isc_channel")" "$(quote_sh "$isc_shell")"
  else
    printf "exec env PURE_FIX=0 %s -i" "$(quote_sh "$isc_shell")"
  fi
}

initial_exec_command() {
  iec_root="$1"
  iec_cmd="$2"
  iec_shell=$(shell_path)
  iec_payload="$(run_in_root "$iec_root" "$iec_cmd"); exec env PURE_FIX=0 $(quote_sh "$iec_shell") -i"
  printf "exec env PURE_FIX=0 %s -ic %s" "$(quote_sh "$iec_shell")" "$(quote_sh "$iec_payload")"
}

new_window_mode_for_target() {
  nwm_type="$1"
  case "$nwm_type" in
  code | git)
    printf 'exec'
    ;;
  run)
    printf 'shell'
    ;;
  *)
    printf 'plain'
    ;;
  esac
}

new_ready_channel() {
  printf 'mux-ready-%s-%s' "$$" "$(date +%s%N)"
}

window_name_for() {
  wnf_type="$1"
  wnf_scope="$2"
  printf '%s@%s' "$wnf_type" "$wnf_scope"
}

window_index_for_name() {
  wifn_name="$1"
  tmux list-windows -F '#{window_name}	#{window_index}' | awk -F'\t' -v n="$wifn_name" '$1 == n { print $2; exit }'
}

current_window_index() {
  tmux display-message -p '#{window_index}'
}

pane_path() {
  pp_target="${1:-}"
  if [ -n "$pp_target" ]; then
    tmux display-message -t "$pp_target" -p '#{pane_current_path}'
  else
    tmux display-message -p '#{pane_current_path}'
  fi
}

pane_command() {
  pc_target="${1:-}"
  if [ -n "$pc_target" ]; then
    tmux display-message -t "$pc_target" -p '#{pane_current_command}'
  else
    tmux display-message -p '#{pane_current_command}'
  fi
}

command_for_pane() {
  cfp_target="$1"
  cfp_root="$2"
  cfp_cmd="$3"
  cfp_path=$(pane_path "$cfp_target")
  if [ "$cfp_path" = "$cfp_root" ]; then
    printf '%s' "$cfp_cmd"
  else
    run_in_root "$cfp_root" "$cfp_cmd"
  fi
}

send_cmd() {
  sc_target="$1"
  sc_root="$2"
  sc_cmd="$3"
  if [ -n "$sc_target" ]; then
    tmux send-keys -t "$sc_target" C-u C-l "$(command_for_pane "$sc_target" "$sc_root" "$sc_cmd")" Enter
  else
    tmux send-keys C-u C-l "$(command_for_pane "" "$sc_root" "$sc_cmd")" Enter
  fi
}

send_initial_cmd() {
  sic_target="$1"
  sic_root="$2"
  sic_cmd="$3"
  if [ -n "$sic_target" ]; then
    tmux send-keys -t "$sic_target" "$(command_for_pane "$sic_target" "$sic_root" "$sic_cmd")" Enter
  else
    tmux send-keys "$(command_for_pane "" "$sic_root" "$sic_cmd")" Enter
  fi
}

schedule_initial_cmd() {
  scd_target="$1"
  scd_cmd="$2"
  scd_channel="${3:-}"
  if [ -n "$scd_channel" ]; then
    scd_payload="tmux wait-for $(quote_sh "$scd_channel"); tmux send-keys -t $(quote_sh "$scd_target") $(quote_sh "$scd_cmd") Enter"
  else
    scd_payload="tmux send-keys -t $(quote_sh "$scd_target") $(quote_sh "$scd_cmd") Enter"
  fi
  tmux run-shell -b "$scd_payload"
}

window_index_from_info() {
  wifi_info="$1"
  wifi_tab=$(printf '\t')
  printf '%s' "${wifi_info%%"$wifi_tab"*}"
}

pane_id_from_info() {
  pifi_info="$1"
  pifi_tab=$(printf '\t')
  printf '%s' "${pifi_info#*"$pifi_tab"}"
}

new_window_info_for_scope() {
  nwifs_name="$1"
  nwifs_root="$2"
  nwifs_cmd="${3:-}"
  nwifs_fmt=$(printf '#{window_index}\t#{pane_id}')
  if [ -n "$nwifs_cmd" ]; then
    nwifs_info=$(tmux new-window -P -F "$nwifs_fmt" -c "$nwifs_root" -n "$nwifs_name" "$nwifs_cmd")
  else
    nwifs_info=$(tmux new-window -P -F "$nwifs_fmt" -c "$nwifs_root" -n "$nwifs_name")
  fi
  nwifs_idx=$(window_index_from_info "$nwifs_info")
  set_root ":${nwifs_idx}" "$nwifs_root"
  printf '%s' "$nwifs_info"
}

new_window_for_scope() {
  nwfs_info=$(new_window_info_for_scope "$@")
  window_index_from_info "$nwfs_info"
}

is_adoptable() {
  ia_shell=$(basename "$SHELL")
  ia_name=$(tmux display-message -p '#{window_name}')
  ia_cmd=$(pane_command)
  ia_panes=$(tmux display-message -p '#{window_panes}')
  [ "$ia_panes" -eq 1 ] && [ "$ia_cmd" = "$ia_shell" ] && [ "$ia_name" = "$ia_shell" ]
}

is_pane_idle() {
  ipi_target="${1:-}"
  ipi_shell=$(basename "$SHELL")
  ipi_pane_cmd=$(pane_command "$ipi_target")
  [ "$ipi_pane_cmd" = "$ipi_shell" ]
}

spawn_or_focus_in() {
  sofi_type="$1"
  sofi_root="$2"
  sofi_cmd="${3:-}"
  sofi_mode="${4:-plain}"
  sofi_scope=$(scope_from_root "$sofi_root")
  sofi_name=$(window_name_for "$sofi_type" "$sofi_scope")
  sofi_idx=$(window_index_for_name "$sofi_name")
  sofi_cur_idx=$(current_window_index)

  if [ -n "$sofi_idx" ] && [ "$sofi_idx" = "$sofi_cur_idx" ]; then
    if [ -n "$sofi_cmd" ] && is_pane_idle; then
      set_root "" "$sofi_root"
      send_cmd "" "$sofi_root" "$sofi_cmd"
    fi
    return
  fi

  if is_adoptable; then
    [ -n "$sofi_idx" ] && tmux kill-window -t ":${sofi_idx}"
    tmux rename-window "$sofi_name"
    set_root "" "$sofi_root"
    [ -n "$sofi_cmd" ] && send_cmd "" "$sofi_root" "$sofi_cmd"
    return
  fi

  if [ -n "$sofi_idx" ]; then
    tmux select-window -t ":${sofi_idx}"
    set_root ":${sofi_idx}" "$sofi_root"
    if [ -n "$sofi_cmd" ] && is_pane_idle ":${sofi_idx}"; then
      send_cmd ":${sofi_idx}" "$sofi_root" "$sofi_cmd"
    fi
    return
  fi

  case "$sofi_mode" in
  exec)
    if [ -n "$sofi_cmd" ]; then
      sofi_idx=$(new_window_for_scope "$sofi_name" "$sofi_root" "$(initial_exec_command "$sofi_root" "$sofi_cmd")")
    else
      sofi_idx=$(new_window_for_scope "$sofi_name" "$sofi_root")
    fi
    ;;
  shell)
    sofi_channel=$(new_ready_channel)
    sofi_info=$(new_window_info_for_scope "$sofi_name" "$sofi_root" "$(initial_shell_command "$sofi_channel")")
    sofi_idx=$(window_index_from_info "$sofi_info")
    if [ -n "$sofi_cmd" ]; then
      sofi_pane=$(pane_id_from_info "$sofi_info")
      schedule_initial_cmd "$sofi_pane" "$sofi_cmd" "$sofi_channel"
    fi
    ;;
  *)
    sofi_idx=$(new_window_for_scope "$sofi_name" "$sofi_root")
    if [ -n "$sofi_cmd" ]; then
      sleep 0.1
      send_initial_cmd ":${sofi_idx}" "$sofi_root" "$sofi_cmd"
    fi
    ;;
  esac
}

run_command_for_scope() {
  rcfs_scope="$1"
  case "$rcfs_scope" in
  neovim)
    printf 'make'
    ;;
  delta)
    printf 'nix develop -c pnpm dev'
    ;;
  barrettruth.com)
    printf 'pnpm dev'
    ;;
  *)
    return 1
    ;;
  esac
}

command_for_target() {
  cft_type="$1"
  cft_scope="$2"
  case "$cft_type" in
  ai)
    printf 'devin'
    ;;
  code)
    printf 'nvim .'
    ;;
  git)
    printf 'nvim -c "Git|only"'
    ;;
  run)
    run_command_for_scope "$cft_scope"
    ;;
  shell)
    :
    ;;
  *)
    return 1
    ;;
  esac
}

require_target_dependencies() {
  rtd_type="$1"
  case "$rtd_type" in
  ai)
    require devin
    ;;
  code)
    require nvim
    ;;
  git)
    require nvim git
    ;;
  esac
}

open_target() {
  open_target_in_root "$1" "$(get_root)"
}

open_target_in_root() {
  otir_type="$1"
  otir_root="$2"
  otir_scope=$(scope_from_root "$otir_root")
  otir_mode=$(new_window_mode_for_target "$otir_type")

  require_target_dependencies "$otir_type"

  case "$otir_type" in
  git)
    if ! git -C "$otir_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      tmux display-message "Not a git repository"
      return 1
    fi
    ;;
  esac

  if ! otir_cmd=$(command_for_target "$otir_type" "$otir_scope"); then
    case "$otir_type" in
    run)
      tmux display-message "mux: no run command for '$otir_scope'"
      ;;
    esac
    return 1
  fi

  spawn_or_focus_in "$otir_type" "$otir_root" "$otir_cmd" "$otir_mode"
}

picker_mode() {
  cat "$_MF" 2>/dev/null || echo open
}

set_picker_mode() {
  spm_mode="$1"
  printf '%s' "$spm_mode" >"$_MF"
}

color_escape() {
  ce_hex="$1"
  printf '\033[38;2;%d;%d;%dm' "0x${ce_hex%????}" "0x$(printf '%.2s' "${ce_hex#??}")" "0x${ce_hex#????}"
}

show_picker() {
  sp_start_mode="${1:-open}"
  require fzf
  _MF="${XDG_RUNTIME_DIR:-/tmp}/mux-picker-mode"
  export _MF
  set_picker_mode "$sp_start_mode"
  _SCOPE=$(get_scope)
  export _SCOPE
  _ACCENT=$(tmux show -gv @accent 2>/dev/null | tr -d '#')
  [ -n "$_ACCENT" ] || _ACCENT="7aa2f7"
  export _ACCENT
  _FGALT=$(tmux show -gv @fgAlt 2>/dev/null | tr -d '#')
  [ -n "$_FGALT" ] || _FGALT="666666"
  export _FGALT
  mux _list | fzf --reverse --ansi --no-info --no-scrollbar \
    --header "$(mux _header)" \
    --prompt "$(mux _prompt)" \
    --pointer '▌' \
    --color "header:#${_FGALT},prompt:#${_ACCENT},separator:#${_FGALT}" \
    --separator '' \
    --delimiter '\t' --with-nth 1 --accept-nth 2 \
    --bind "ctrl-o:execute-silent(mux _toggle proj)+reload(mux _list)+transform-header(mux _header)+transform-prompt(mux _prompt)" \
    --bind "enter:ignore" \
    --bind "ctrl-a:become(mux _picker_open ai {2})" \
    --bind "ctrl-c:become(mux _picker_open code {2})" \
    --bind "ctrl-s:become(mux _picker_open shell {2})" \
    --bind "ctrl-r:become(mux _picker_open run {2})" \
    --bind "ctrl-g:become(mux _picker_open git {2})" \
    --bind "ctrl-x:execute-silent(mux _dispatch kill:{2})+reload(mux _list)+transform-header(mux _header)"
}

picker_prompt() {
  ppr_mode=$(picker_mode)
  case "$ppr_mode" in
  open)
    printf '@%s> ' "$_SCOPE"
    ;;
  *)
    printf 'open> '
    ;;
  esac
}

picker_header() {
  ph_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  ph_rst=$(printf '\033[0m')
  ph_mode=$(picker_mode)
  case "$ph_mode" in
  open)
    printf ':: %s^A%s ai %s^C%s code %s^S%s shell %s^R%s run %s^G%s git %s^X%s kill %s^O%s projects' \
      "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst"
    ;;
  *)
    printf ':: %s^A%s ai %s^C%s code %s^S%s shell %s^R%s run %s^G%s git %s^O%s windows' \
      "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst" "$ph_ac" "$ph_rst"
    ;;
  esac
}

list_open_entries() {
  loe_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  loe_muted=$(color_escape "${_FGALT:-666666}")
  loe_rst=$(printf '\033[0m')
  loe_windows=$(tmux list-windows -F '#{window_name}	#{window_index}')
  for loe_type in ai code shell run git; do
    loe_name=$(window_name_for "$loe_type" "$_SCOPE")
    loe_idx=$(printf '%s\n' "$loe_windows" | awk -F'\t' -v n="$loe_name" '$1 == n { print $2; exit }')
    if [ -n "$loe_idx" ]; then
      printf '%s%s%s %s*%s%s\topen:%s\n' "$loe_ac" "$loe_type" "$loe_rst" "$loe_muted" "$loe_idx" "$loe_rst" "$loe_type"
    else
      printf '%s\topen:%s\n' "$loe_type" "$loe_type"
    fi
  done
}

list_project_entries() {
  lpe_ac=$(color_escape "${_ACCENT:-7aa2f7}")
  lpe_rst=$(printf '\033[0m')
  lpe_projects=$(zoxide query -l 2>/dev/null || true)
  [ -n "$lpe_projects" ] || return 0
  while IFS= read -r lpe_dir; do
    [ -n "$lpe_dir" ] || continue
    lpe_root=$(git -C "$lpe_dir" rev-parse --show-toplevel 2>/dev/null || true)
    [ "$lpe_root" = "$lpe_dir" ] || continue
    lpe_name=$(basename "$lpe_dir")
    if [ "$lpe_name" = "$_SCOPE" ]; then
      printf '%s%s%s\tproj:%s\n' "$lpe_ac" "$lpe_name" "$lpe_rst" "$lpe_dir"
    else
      printf '%s\tproj:%s\n' "$lpe_name" "$lpe_dir"
    fi
  done <<EOF
$lpe_projects
EOF
}

picker_list() {
  pl_mode=$(picker_mode)
  case "$pl_mode" in
  open)
    list_open_entries
    ;;
  *)
    list_project_entries
    ;;
  esac
}

toggle_picker_mode() {
  tpm_target_mode="$1"
  tpm_mode=$(picker_mode)
  if [ "$tpm_mode" = "$tpm_target_mode" ]; then
    set_picker_mode open
  else
    set_picker_mode "$tpm_target_mode"
  fi
}

dispatch_picker_action() {
  dpa_input="$1"
  dpa_mode="${dpa_input%%:*}"
  dpa_action="${dpa_input#*:}"
  case "$dpa_mode" in
  open)
    exec mux "$dpa_action"
    ;;
  proj)
    dpa_type=code
    dpa_dir="$dpa_action"
    case "$dpa_action" in
    ai:* | code:* | shell:* | run:* | git:*)
      dpa_type="${dpa_action%%:*}"
      dpa_dir="${dpa_action#*:}"
      ;;
    esac
    open_target_in_root "$dpa_type" "$dpa_dir"
    ;;
  kill)
    dpa_submode="${dpa_action%%:*}"
    dpa_type="${dpa_action#*:}"
    case "$dpa_submode" in
    open)
      dpa_name=$(window_name_for "$dpa_type" "$_SCOPE")
      tmux kill-window -t "=$dpa_name" 2>/dev/null
      ;;
    esac
    ;;
  esac
}

picker_open_target() {
  pot_type="$1"
  pot_input="$2"
  pot_mode=$(picker_mode)
  case "$pot_mode" in
  open)
    exec mux "$pot_type"
    ;;
  *)
    pot_submode="${pot_input%%:*}"
    pot_dir="${pot_input#*:}"
    [ "$pot_submode" = "proj" ] && open_target_in_root "$pot_type" "$pot_dir"
    ;;
  esac
}

session_key() {
  sk_index="$1"
  sk_total="$2"
  case "$sk_index" in
  0)
    printf 'H'
    ;;
  1)
    printf 'J'
    ;;
  2)
    printf 'K'
    ;;
  3)
    printf 'L'
    ;;
  *)
    if [ "$sk_index" -eq "$((sk_total - 1))" ]; then
      printf '$'
    else
      printf '?'
    fi
    ;;
  esac
}

render_bar() {
  if [ "$(tmux show-options -gv mouse)" = "on" ]; then
    rb_indicator='#{?pane_in_mode,[mouse#{@c}copy],[mouse]}'
  else
    rb_indicator='#{?pane_in_mode,[copy],}'
  fi

  rb_sessions=$(tmux ls -F '#{session_id}	#{session_name}')
  rb_bar_content=""

  if [ -n "$rb_sessions" ]; then
    rb_tab=$(printf '\t')
    rb_total=$(printf '%s\n' "$rb_sessions" | wc -l | tr -d ' ')
    rb_index=0

    while IFS= read -r rb_line; do
      [ -n "$rb_line" ] || continue
      rb_sid=${rb_line%%"${rb_tab}"*}
      rb_sname=${rb_line#*"${rb_tab}"}
      rb_key=$(session_key "$rb_index" "$rb_total")
      rb_star="#{?#{==:#S,$rb_sname},#[fg=#{@accent}]*#[default],}"
      [ -n "$rb_bar_content" ] && rb_bar_content="$rb_bar_content │ "
      rb_bar_content="$rb_bar_content#[range=session|${rb_sid}]${rb_star}${rb_key}#[fg=#{@accent}]:#[default]${rb_sname}#[norange]"
      rb_index=$((rb_index + 1))
    done <<EOF
$rb_sessions
EOF
  fi

  tmux set -g status-left-length 80
  tmux set -g status-right-length 80
  tmux set -g status-left ' '
  tmux set -g window-status-format '#[range=window|#{window_index}]#{?window_last_flag,#[fg=#{@accent}]-#[default],}#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-current-format '#[range=window|#{window_index}]#[fg=#{@accent}]*#[default]#{window_index}#[fg=#{@accent}]:#[default]#{window_name}#[norange]'
  tmux set -g window-status-separator ' │ '
  tmux set -g @bar-content "$rb_indicator $rb_bar_content "
}

switch_session() {
  ss_slot="$1"
  ss_session=$(tmux ls -F '#S' | sed -n "$((ss_slot + 1))p")
  [ -n "$ss_session" ] && tmux switch -t "$ss_session"
}

main() {
  case "${1:-}" in
  bar)
    render_bar
    ;;
  switch)
    switch_session "$2"
    ;;
  ai | code | git | run | shell)
    open_target "$1"
    ;;
  open)
    show_picker open
    ;;
  projects)
    show_picker proj
    ;;
  _prompt)
    picker_prompt
    ;;
  _header)
    picker_header
    ;;
  _list)
    picker_list
    ;;
  _toggle)
    toggle_picker_mode "$2"
    ;;
  _dispatch)
    dispatch_picker_action "$2"
    ;;
  _picker_open)
    picker_open_target "$2" "$3"
    ;;
  *)
    tmux attach 2>/dev/null || tmux new-session
    ;;
  esac
}

main "$@"
