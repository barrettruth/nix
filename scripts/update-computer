#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_file="${repo_root}/pkgs/computer.nix"
url_base="https://www.agentcomputer.ai/install/cli/latest"

expected_hex=$(curl -fsSL "${url_base}/computer-linux-x64.sha256" | tr -d '[:space:]')
new_sri=$(nix hash convert --hash-algo sha256 --to sri "${expected_hex}")
current_sri=$(grep -oE 'sha256-[A-Za-z0-9+/=]+' "${nix_file}" | head -1)

if [[ "${new_sri}" == "${current_sri}" ]]; then
  echo "agentcomputer: up-to-date (${new_sri})"
  exit 0
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "${tmpdir}"' EXIT
curl -fsSL "${url_base}/computer-linux-x64" -o "${tmpdir}/computer"
chmod +x "${tmpdir}/computer"

got_hex=$(sha256sum "${tmpdir}/computer" | awk '{print $1}')
if [[ "${got_hex}" != "${expected_hex}" ]]; then
  echo "checksum mismatch: expected ${expected_hex}, got ${got_hex}" >&2
  exit 1
fi

new_version=$("${tmpdir}/computer" --version 2>/dev/null | tr -d '[:space:]')
if [[ -z "${new_version}" ]]; then
  echo "could not read --version from downloaded binary" >&2
  exit 1
fi

current_version=$(grep -oE '^[[:space:]]*version = "[^"]+"' "${nix_file}" | head -1 | sed -E 's/.*"([^"]+)"/\1/')

echo "agentcomputer: ${current_version} -> ${new_version}"
echo "              ${current_sri} -> ${new_sri}"

sed -i \
  -e "s|${current_sri}|${new_sri}|" \
  -e "s|version = \"${current_version}\"|version = \"${new_version}\"|" \
  "${nix_file}"

echo "patched ${nix_file}"
echo "run: doas nixos-rebuild switch --flake ~/.config/nix#xps15"
