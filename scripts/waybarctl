#!/bin/sh

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state_file="$state_dir/waybar"
pid_file="$state_dir/waybar.pid"
theme_pending_file="$state_dir/waybar-theme-pending"
theme_link="$cfg/waybar/themes/theme.css"

current_theme() {
  theme="$(cat "$state_dir/theme" 2>/dev/null || true)"
  case "$theme" in
  daylight | midnight) printf '%s\n' "$theme" ;;
  *) printf '%s\n' midnight ;;
  esac
}

write_state() {
  mkdir -p "$state_dir"
  printf '%s\n' "$1" >"$state_file"
}

write_pid() {
  mkdir -p "$state_dir"
  printf '%s\n' "$1" >"$pid_file"
}

read_state() {
  state="$(cat "$state_file" 2>/dev/null || true)"
  case "$state" in
  shown | hidden) printf '%s\n' "$state" ;;
  *) return 1 ;;
  esac
}

pid_is_waybar() {
  pid="$1"
  case "$pid" in
  '' | *[!0-9]*) return 1 ;;
  esac
  [ -r "/proc/$pid/comm" ] || return 1
  IFS= read -r comm <"/proc/$pid/comm" || return 1
  case "$comm" in
  waybar | .waybar-wrapped) kill -0 "$pid" 2>/dev/null ;;
  *) return 1 ;;
  esac
}

cached_pid() {
  IFS= read -r pid <"$pid_file" 2>/dev/null || return 1
  pid_is_waybar "$pid" || {
    rm -f "$pid_file"
    return 1
  }
  printf '%s\n' "$pid"
}

find_waybar_pid() {
  cached_pid && return 0
  for pid in $(
    pgrep -x '[.]waybar-wrapped' 2>/dev/null
    pgrep -x waybar 2>/dev/null
  ); do
    pid_is_waybar "$pid" || continue
    write_pid "$pid"
    printf '%s\n' "$pid"
    return 0
  done
  return 1
}

is_running() {
  find_waybar_pid >/dev/null
}

signal_waybar() {
  pid="$(find_waybar_pid)" || return 0
  kill "-$1" "$pid" 2>/dev/null || rm -f "$pid_file"
}

sync_theme() {
  theme_changed=0
  theme="$(current_theme)"
  target="$cfg/waybar/themes/$theme.css"

  [ -f "$target" ] || return 0
  current_target="$(readlink -f "$theme_link" 2>/dev/null || true)"
  desired_target="$(readlink -f "$target" 2>/dev/null || true)"
  [ "$current_target" = "$desired_target" ] && return 0

  ln -sf "$target" "$theme_link"
  theme_changed=1
}

show_bar() {
  sync_theme
  if is_running; then
    state="$(read_state 2>/dev/null || true)"
    if [ "$state" = hidden ]; then
      if [ "$theme_changed" = 1 ] || [ -f "$theme_pending_file" ]; then
        signal_waybar USR2
        rm -f "$theme_pending_file"
      else
        signal_waybar USR1
      fi
    fi
  else
    rm -f "$theme_pending_file"
    nohup waybar >/dev/null 2>&1 &
    write_pid "$!"
  fi
  write_state shown
}

hide_bar() {
  is_running || {
    write_state hidden
    return 0
  }
  state="$(read_state 2>/dev/null || true)"
  [ "$state" = shown ] && signal_waybar USR1
  write_state hidden
}

toggle_bar() {
  if ! is_running; then
    show_bar
    return 0
  fi
  state="$(read_state 2>/dev/null || true)"
  case "$state" in
  hidden) show_bar ;;
  shown) hide_bar ;;
  *)
    signal_waybar USR1
    write_state hidden
    ;;
  esac
}

apply_theme() {
  sync_theme
  if [ "$(read_state 2>/dev/null || true)" = hidden ]; then
    [ "$theme_changed" = 1 ] && {
      mkdir -p "$state_dir"
      : >"$theme_pending_file"
    }
    return 0
  fi
  rm -f "$theme_pending_file"
  is_running && signal_waybar USR2
}

case "$1" in
toggle) toggle_bar ;;
show) show_bar ;;
hide) hide_bar ;;
apply-theme) apply_theme ;;
sync-theme) sync_theme ;;
state)
  if ! is_running; then
    printf '%s\n' stopped
    exit 0
  fi
  read_state 2>/dev/null || printf '%s\n' unknown
  ;;
*)
  printf '%s\n' "usage: waybarctl {toggle|show|hide|apply-theme|sync-theme|state}" >&2
  exit 1
  ;;
esac
