#!/bin/sh

require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "ctl: missing dependency: $cmd" >&2
      exit 1
    }
  done
}

mkbar() {
  pct="$1"
  [ "$pct" -lt 0 ] && pct=0
  [ "$pct" -gt 100 ] && pct=100
  filled=$((pct * 30 / 100))
  empty=$((30 - filled))
  bar="["
  i=0
  while [ "$i" -lt "$filled" ]; do
    bar="${bar}="
    i=$((i + 1))
  done
  i=0
  while [ "$i" -lt "$empty" ]; do
    bar="${bar} "
    i=$((i + 1))
  done
  printf '%s]' "$bar"
}

whisper_idle_cancel() {
  systemctl --user stop whisper-idle.timer whisper-idle.service 2>/dev/null
}

whisper_idle_schedule() {
  delay="$1"
  whisper_idle_cancel
  systemd-run --user --quiet --unit=whisper-idle --on-active="${delay}s" systemctl --user stop whisper-dictation >/dev/null 2>&1
}

whisper_idle_timeout() {
  history="$1"
  now="$(date +%s)"
  tmp="$history.tmp"
  count=0
  : >"$tmp"
  if [ -f "$history" ]; then
    while IFS= read -r ts; do
      case "$ts" in
      '' | *[!0-9]*) continue ;;
      esac
      if [ $((now - ts)) -le 600 ]; then
        printf '%s\n' "$ts" >>"$tmp"
        count=$((count + 1))
      fi
    done <"$history"
  fi
  printf '%s\n' "$now" >>"$tmp"
  mv "$tmp" "$history"
  count=$((count + 1))
  case "$count" in
  1) echo 20 ;;
  2 | 3) echo 60 ;;
  *) echo 180 ;;
  esac
}

grayscale_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
grayscale_state_file="$grayscale_state_dir/grayscale"
grayscale_shader_file="$grayscale_state_dir/screen-shader.frag"
grayscale_shader_dir="${BARRETT_NIX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nix/config}/hypr/shaders"
grayscale_read_state() {
  state="$(cat "$grayscale_state_file" 2>/dev/null || true)"
  case "$state" in
  on) printf '%s\n' on ;;
  *) printf '%s\n' off ;;
  esac
}

grayscale_write_state() {
  mkdir -p "$grayscale_state_dir"
  printf '%s\n' "$1" >"$grayscale_state_file"
}

grayscale_target() {
  case "$1" in
  on) printf '%s\n' "$grayscale_shader_dir/grayscale.frag" ;;
  *) printf '%s\n' "$grayscale_shader_dir/pass-through.frag" ;;
  esac
}

grayscale_apply_runtime() {
  target="$(grayscale_target "$(grayscale_read_state)")"
  [ -f "$target" ] || {
    echo "ctl: missing shader: $target" >&2
    exit 1
  }
  mkdir -p "$grayscale_state_dir"
  ln -sfnT "$target" "$grayscale_shader_file"
  if [ "${XDG_CURRENT_DESKTOP:-}" = "Hyprland" ]; then
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$target\" } })" >/dev/null
  fi
}

grayscale_on() {
  grayscale_write_state on
  grayscale_apply_runtime
}

grayscale_off() {
  grayscale_write_state off
  grayscale_apply_runtime
}

case "$(uname)" in
Darwin)
  case "$1" in
  screenshot | keyboard | audio | battery | brightness | volume | wifi | media | clip | power | dictate | grayscale)
    echo "ctl: $1 is linux-only" >&2
    exit 1
    ;;
  esac
  ;;
esac

case "$1" in
screenshot)
  dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
  mkdir -p "$dir"
  file="$dir/$(openssl rand -hex 10)-$(date +'%Y-%m-%d_%H-%M-%S').png"
  require grim slurp wl-copy
  grim -g "$(slurp)" "$file" && wl-copy <"$file"
  ;;
keyboard)
  case "$2" in
  next)
    hyprctl switchxkblayout current next
    ;;
  pick)
    require fuzzel jq
    active="$(hyprctl devices -j 2>/dev/null | jq -r '.keyboards[] | select(.main) | .active_keymap' 2>/dev/null || true)"
    case "$active" in
    *Baremak*) current="Baremak" ;;
    *Dvorak*) current="Dvorak" ;;
    *Colemak*) current="Colemak" ;;
    *) current="QWERTY" ;;
    esac
    choice=$(printf 'QWERTY\nDvorak\nColemak\nBaremak' |
      awk -v cur="$current" '{
        prefix = ($0 == cur) ? "  >   " : "      "
        printf "%s%s\t%s\n", prefix, $0, $0
      }' |
      fuzzel --dmenu --prompt="kbd:  " --no-icons --lines=4 \
        --with-nth=1 --accept-nth=2 --font="Berkeley Mono:size=12" --width=25)
    [ -z "$choice" ] && exit 0
    case "$choice" in
    QWERTY) index=0 ;;
    Dvorak) index=1 ;;
    Colemak) index=2 ;;
    Baremak) index=3 ;;
    esac
    if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ]; then
      hyprctl eval 'hl.config({ input = { kb_layout = "us,us,us,baremak", kb_variant = ",dvorak,colemak_dh," } })'
      hyprctl switchxkblayout current "$index"
    fi
    ;;
  *)
    echo "Usage: ctl keyboard {next|pick}" >&2
    exit 1
    ;;
  esac
  ;;
audio)
  require wpctl pw-dump jq fuzzel
  case "$2" in
  sink | source)
    if [ "$2" = sink ]; then
      class="Audio/Sink"
      prompt="sink:  "
      default_meta="default.audio.sink"
      node="@DEFAULT_AUDIO_SINK@"
      pad=7
    else
      class="Audio/Source"
      prompt="source: "
      default_meta="default.audio.source"
      node="@DEFAULT_AUDIO_SOURCE@"
      pad=8
    fi
    while :; do
      dump=$(pw-dump)
      devices=$(printf '%s' "$dump" | jq -r --arg class "$class" \
        '.[] | select(.info.props."media.class" == $class) | "\(.id)\t\(.info.props."node.description" // .info.props."node.name" // "unknown")\t\(.info.props."node.name" // "")"')
      [ -z "$devices" ] && exit 0
      default_name=$(printf '%s' "$dump" | jq -r --arg key "$default_meta" \
        '.[] | select(.type == "PipeWire:Interface:Metadata" and .props."metadata.name" == "default") | .metadata[] | select(.key == $key) | .value.name')
      rows=$(printf '%s\n' "$devices" | while IFS="$(printf '\t')" read -r id name node_name; do
        node_sfx="${node_name#*.}"
        def_sfx="${default_name#*.}"
        if [ "$node_name" = "$default_name" ] || { [ -n "$node_sfx" ] && [ "$node_sfx" = "$def_sfx" ]; }; then
          active=">"
        else
          active=""
        fi
        vol=$(wpctl get-volume "$id" 2>/dev/null | awk '{printf "%d", $2 * 100}')
        printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$active" "$vol"
      done)
      [ -z "$rows" ] && exit 0
      w1=$(printf '%s\n' "$rows" | awk -F'\t' 'BEGIN{m=11}{l=length($2);if(l>m)m=l}END{print m}')
      fw=$((w1 + pad + 16))
      sep=$(awk -v n="$((w1 + 10))" 'BEGIN{for(i=0;i<n;i++)printf "─";print ""}')
      indent=$(printf "%${pad}s" "")
      active_prefix=$(printf "  >%$((pad - 3))s" "")
      header=$(printf "%s%-*s    %s\n%s%s" "$indent" "$w1" "Device name" "Volume" "$indent" "$sep")
      count=$(printf '%s\n' "$rows" | wc -l)
      choice=$(printf '%s\n' "$rows" |
        awk -F'\t' -v w1="$w1" -v indent="$indent" -v active_prefix="$active_prefix" '{
          prefix = ($3 == ">") ? active_prefix : indent
          printf "%s%-*s    %3d%%\t%s\n", prefix, w1, $2, $4, $1
        }' |
        fuzzel --dmenu --prompt="$prompt" --no-icons --lines="$count" \
          --with-nth=1 --accept-nth=2 \
          --mesg="$header" --mesg-mode=expand \
          --font="Berkeley Mono:size=12" --width="$fw")
      rc=$?
      [ "$rc" = 10 ] && continue
      [ "$rc" = 11 ] && {
        wpctl set-volume "$node" 5%+ --limit 1.0
        continue
      }
      [ "$rc" = 12 ] && {
        wpctl set-volume "$node" 5%-
        continue
      }
      [ -z "$choice" ] && exit 0
      wpctl set-default "$choice"
      break
    done
    ;;
  *)
    echo "Usage: ctl audio {sink|source}" >&2
    exit 1
    ;;
  esac
  ;;
battery)
  require notify-send
  case "$2" in
  notify) ;;
  *)
    echo "Usage: ctl battery notify" >&2
    exit 1
    ;;
  esac
  pct=""
  for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/capacity" ] || continue
    pct=$(cat "$b/capacity")
    status=$(cat "$b/status" 2>/dev/null)
    break
  done
  [ -n "$pct" ] || exit 0
  case "$status" in
  Discharging) ;;
  *) [ "$pct" -ge 100 ] || exit 0 ;;
  esac
  if [ "$status" = Discharging ] && [ "$pct" -le 10 ]; then
    urgency=critical
  elif [ "$status" = Discharging ] && [ "$pct" -le 20 ]; then
    urgency=normal
  else
    urgency=low
  fi
  notify-send -a ctl -r 5557 -u "$urgency" "Battery $pct%" "$(mkbar "$pct")"
  ;;
brightness)
  require brightnessctl notify-send
  BRIGHT_STEP=5
  case "$2" in
  up) brightnessctl set "$BRIGHT_STEP"%+ ;;
  down) brightnessctl set "$BRIGHT_STEP"%- ;;
  *)
    echo "Usage: ctl brightness {up|down}" >&2
    exit 1
    ;;
  esac
  pct=$(awk -v cur="$(brightnessctl get)" -v max="$(brightnessctl max)" 'BEGIN { printf "%d", cur * 100 / max }')
  notify-send -a ctl -t 2500 -r 5555 "Brightness $pct%" "$(mkbar "$pct")"
  ;;
volume)
  require wpctl notify-send
  SINK="@DEFAULT_AUDIO_SINK@"
  VOL_STEP=5
  get_vol() { wpctl get-volume "$SINK" | awk '{printf "%d", $2 * 100}'; }
  case "$2" in
  up) wpctl set-volume "$SINK" "${VOL_STEP}%+" --limit 1.0 ;;
  down) wpctl set-volume "$SINK" "${VOL_STEP}%-" ;;
  toggle) wpctl set-mute "$SINK" toggle ;;
  *)
    echo "Usage: ctl volume {up|down|toggle}" >&2
    exit 1
    ;;
  esac
  if wpctl get-volume "$SINK" | grep -q MUTED; then
    notify-send -a ctl -t 2500 -r 5556 "Volume" "Muted"
  else
    vol=$(get_vol)
    notify-send -a ctl -t 2500 -r 5556 "Volume $vol%" "$(mkbar "$vol")"
  fi
  ;;
wifi)
  case "$2" in
  pick)
    pkill -x fuzzel 2>/dev/null && exit 0
    require fuzzel iwctl
    station=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | awk '/station/{print $1}')
    [ -z "$station" ] && {
      echo "ctl: no wifi device found" >&2
      exit 1
    }
    wifi_networks() {
      iwctl station "$station" get-networks 2>/dev/null |
        sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' |
        awk 'NR>4 && /\S/ && !/^[[:space:]]*-/' |
        awk '{
          active = ($0 ~ /^[[:space:]]*>/) ? ">" : ""
          sub(/^[[:space:]>]*/, "")
          sub(/[[:space:]]*$/, "")
          i = index($0, "   ")
          if (i > 0) {
            ssid = substr($0, 1, i - 1)
            rest = substr($0, i)
            sub(/^[[:space:]]*/, "", rest)
            j = index(rest, "   ")
            if (j > 0) {
              security = substr(rest, 1, j - 1)
              signal = substr(rest, j)
              sub(/^[[:space:]]*/, "", signal)
              sub(/[[:space:]]*$/, "", signal)
            } else {
              security = rest
              signal = ""
            }
            sub(/[[:space:]]*$/, "", ssid)
            sub(/[[:space:]]*$/, "", security)
            printf "%s\t%s\t%s\t%s\n", ssid, security, signal, active
          }
        }'
    }
    wifi_rescan() {
      scan_prev="$1"
      scan_cur=""
      iwctl station "$station" scan >/dev/null 2>&1 &
      scan_retry=0
      while [ "$scan_retry" -lt 10 ]; do
        scan_cur=$(wifi_networks)
        [ -n "$scan_cur" ] && [ "$scan_cur" != "$scan_prev" ] && break
        scan_retry=$((scan_retry + 1))
        sleep 0.2
      done
      [ -n "$scan_cur" ] && printf '%s\n' "$scan_cur" || printf '%s\n' "$scan_prev"
    }
    networks=$(wifi_networks)
    while :; do
      [ -z "$networks" ] && exit 0
      w1=$(printf '%s\n' "$networks" | awk -F'\t' 'BEGIN{m=12}{l=length($1);if(l>m)m=l}END{print m}')
      w2=$(printf '%s\n' "$networks" | awk -F'\t' 'BEGIN{m=8}{l=length($2);if(l>m)m=l}END{print m}')
      w3=$(printf '%s\n' "$networks" | awk -F'\t' 'BEGIN{m=6}{l=length($3);if(l>m)m=l}END{print m}')
      fw=$((w1 + 4 + w2 + 4 + w3 + 17))
      sep=$(awk -v n="$((w1 + w2 + w3 + 8))" 'BEGIN{for(i=0;i<n;i++)printf "─";print ""}')
      header=$(printf "       %-*s    %-*s    %s\n       %s" "$w1" "Network name" "$w2" "Security" "Signal" "$sep")
      ssid=$(printf '%s\n' "$networks" |
        awk -F'\t' -v w1="$w1" -v w2="$w2" '{
          prefix = ($4 == ">") ? "  >    " : "       "
          printf "%s%-*s    %-*s    %s\t%s\n", prefix, w1, $1, w2, $2, $3, $1
        }' |
        fuzzel --dmenu --prompt="wifi:  " --no-icons --minimal-lines \
          --with-nth=1 --accept-nth=2 \
          --mesg="$header" --mesg-mode=expand \
          --font="Berkeley Mono:size=12" --width="$fw")
      rc=$?
      [ "$rc" = 10 ] && {
        networks=$(wifi_rescan "$networks")
        continue
      }
      [ -z "$ssid" ] && exit 0
      break
    done
    known=$(iwctl known-networks list 2>/dev/null | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g')
    if printf '%s' "$known" | grep -qF "$ssid"; then
      iwctl station "$station" connect "$ssid"
    elif iwctl station "$station" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | grep -F "$ssid" | grep -qi "open"; then
      iwctl station "$station" connect "$ssid"
    else
      pass=$(printf '' | fuzzel --dmenu --prompt="passphrase:  " --no-icons --password --lines=0)
      [ -z "$pass" ] && exit 0
      iwctl station "$station" connect "$ssid" --passphrase "$pass"
    fi
    ;;
  *)
    echo "Usage: ctl wifi {pick}" >&2
    exit 1
    ;;
  esac
  ;;
media)
  recording_state="${XDG_RUNTIME_DIR:-/tmp}/ctl-recording"
  recording_alive() {
    pid="$1"
    case "$pid" in
    '' | *[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    comm=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ "$comm" = wf-recorder ]
  }
  recording_load() {
    rec_pid=""
    rec_file=""
    [ -f "$recording_state" ] || return 1
    {
      IFS= read -r rec_pid || return 1
      IFS= read -r rec_file || rec_file=""
    } <"$recording_state"
    case "$rec_pid" in
    '' | *[!0-9]*) return 1 ;;
    esac
    [ -n "$rec_file" ]
  }
  recording_save() {
    printf '%s\n%s\n' "$1" "$2" >"$recording_state"
  }
  if recording_load && recording_alive "$rec_pid"; then
    kill -INT "$rec_pid" 2>/dev/null || true
    rm -f "$recording_state"
    printf '%s' "$rec_file" | wl-copy
    notify-send -a ctl -t 2500 "Screen capture" "Recording saved to ~${rec_file#"$HOME"}"
    exit 0
  fi
  rm -f "$recording_state"
  pkill -x fuzzel 2>/dev/null && exit 0
  require fuzzel grim slurp wl-copy wf-recorder hyprctl jq tesseract
  ss_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
  rec_dir="${XDG_VIDEOS_DIR:-$HOME/Videos}"
  mkdir -p "$ss_dir" "$rec_dir"
  rec_watchdog() {
    target_pid="$1"
    target_file="$2"
    (
      sleep 60
      recording_load || exit 0
      if [ "$rec_pid" = "$target_pid" ] && [ "$rec_file" = "$target_file" ] && recording_alive "$target_pid"; then
        kill -INT "$target_pid" 2>/dev/null || true
        sleep 0.5
        rm -f "$recording_state"
        printf '%s' "$target_file" | wl-copy
        notify-send -a ctl -t 2500 "Screen capture" "1 minute reached; saved to ~${target_file#"$HOME"}"
      fi
    ) &
  }
  cap_desktop="   Capture Screen"
  cap_area="   Capture Area"
  cap_window="   Capture Window"
  rec_desktop="   Record Screen"
  rec_area="   Record Area"
  rec_window="   Record Window"
  ocr_area="   OCR Area"
  chosen="$(printf '%s\n' "$cap_desktop" "$cap_area" "$cap_window" "$rec_desktop" "$rec_area" "$rec_window" "$ocr_area" | fuzzel --dmenu --hide-prompt --lines=7 --width=25 --no-icons 2>/dev/null)"
  case "$chosen" in
  "$cap_desktop")
    file="$ss_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"
    grim "$file" && wl-copy <"$file" && echo "$file" && notify-send -a ctl -t 2500 "Screen capture" "Screenshot saved to ~${file#"$HOME"}"
    ;;
  "$cap_area")
    file="$ss_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"
    grim -g "$(slurp)" "$file" && wl-copy <"$file" && echo "$file" && notify-send -a ctl -t 2500 "Screen capture" "Screenshot saved to ~${file#"$HOME"}"
    ;;
  "$cap_window")
    geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    file="$ss_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"
    grim -g "$geom" "$file" && wl-copy <"$file" && echo "$file" && notify-send -a ctl -t 2500 "Screen capture" "Screenshot saved to ~${file#"$HOME"}"
    ;;
  "$rec_desktop")
    file="$rec_dir/$(date +'%Y-%m-%d_%H-%M-%S').mp4"
    wf-recorder -f "$file" &
    rec_pid="$!"
    recording_save "$rec_pid" "$file"
    notify-send -a ctl -t 2500 "Screen capture" "Recording started"
    rec_watchdog "$rec_pid" "$file"
    ;;
  "$rec_area")
    region="$(slurp)" || exit 0
    [ -n "$region" ] || exit 0
    file="$rec_dir/$(date +'%Y-%m-%d_%H-%M-%S').mp4"
    wf-recorder -g "$region" -f "$file" &
    rec_pid="$!"
    recording_save "$rec_pid" "$file"
    notify-send -a ctl -t 2500 "Screen capture" "Recording started"
    rec_watchdog "$rec_pid" "$file"
    ;;
  "$rec_window")
    geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    file="$rec_dir/$(date +'%Y-%m-%d_%H-%M-%S').mp4"
    wf-recorder -g "$geom" -f "$file" &
    rec_pid="$!"
    recording_save "$rec_pid" "$file"
    notify-send -a ctl -t 2500 "Screen capture" "Recording started"
    rec_watchdog "$rec_pid" "$file"
    ;;
  "$ocr_area")
    file="$ss_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"
    region="$(slurp)" || exit 0
    [ -n "$region" ] || exit 0
    grim -g "$region" "$file" && tesseract -l eng "$file" - 2>/dev/null | wl-copy
    ;;
  esac
  ;;
wallpaper)
  require nix-shell
  _wp=$(mktemp "${TMPDIR:-/tmp}/ctl_wp_XXXXXX")
  trap 'rm -f "$_wp"' EXIT
  cat >"$_wp" <<'PYTHON'
# /// script
# dependencies = ["pillow"]
# ///
from collections.abc import Iterator
from datetime import datetime
import glob
import json
import math
import os
import random
import subprocess
import sys
import urllib.request
from io import BytesIO

from PIL import Image, ImageChops, ImageDraw, ImageFilter, ImageFont

Coord = tuple[float, float]
Candidate = tuple[float, float, str]
ContourMetrics = tuple[float, int, float]
Rgb = tuple[int, int, int]

HOME: str = os.environ["HOME"]
DIR: str = os.path.join(os.environ.get("XDG_PICTURES_DIR", os.path.join(HOME, "Pictures")), "Screensavers")
STATE: str = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "theme")
LOG_DIR: str = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "wallpaper")
LOG_FILE: str = os.path.join(LOG_DIR, "gen.log")
CACHE: str = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "wallpaper")
os.makedirs(DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)
os.makedirs(CACHE, exist_ok=True)

TILE_URL: str = "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
TILE_SIZE: int = 256
ZOOM: int = 11
CONTOUR_LEVELS: int = 20

def font_path() -> str:
    candidates = [
        os.path.join(HOME, ".local", "share", "fonts", "berkeley-mono", "BerkeleyMono-Regular.ttf"),
    ]
    candidates.extend(sorted(glob.glob("/Library/Fonts/Nix Fonts/*/share/fonts/barrett/berkeley-mono/BerkeleyMono-Regular.ttf")))
    for candidate in candidates:
        if os.path.exists(candidate):
            return candidate
    try:
        matched = subprocess.check_output(
            ["fc-match", "-f", "%{file}\n", "Berkeley Mono:style=Regular"],
            text=True,
        ).splitlines()[0]
        if matched:
            return matched
    except Exception:
        pass
    return candidates[0]


FONT: str = font_path()

THEMES: dict[str, dict[str, Rgb]] = {
    "midnight": {"bg": (0x12, 0x12, 0x12), "line": (0x2a, 0x2a, 0x2a), "label": (0x55, 0x55, 0x55)},
    "daylight": {"bg": (0xf5, 0xf5, 0xf5), "line": (0xdc, 0xdc, 0xdc), "label": (0x88, 0x88, 0x88)},
}

LOCATIONS: list[Coord] = [
    (46.56, 7.69),
    (36.10, -112.09),
    (27.99, 86.93),
    (61.22, 6.78),
    (-50.94, -73.15),
    (36.25, 137.60),
    (39.11, -106.45),
    (46.42, 11.84),
    (44.07, 6.87),
    (-43.59, 170.14),
    (64.07, -16.20),
    (28.60, 83.82),
    (42.50, 44.50),
    (47.07, 12.69),
    (45.83, 6.86),
]

MIN_RELIEF: int = 400
MAX_RETRIES: int = 20
SEA_LEVEL: int = 32768
MIN_LAND_FRACTION: float = 0.1
PREVIEW_W: int = 384
PREVIEW_H: int = 240
GRID_COLS: int = 6
GRID_ROWS: int = 4
MIN_CONTOUR_COVERAGE: float = 0.15
MIN_OCCUPIED_CELLS: int = 12
MAX_CELL_SHARE: float = 0.15
RUN_ID: str = f"{datetime.now().strftime('%Y%m%dT%H%M%S')}-pid{os.getpid()}"


def log(message: str) -> None:
    line = f"{datetime.now().astimezone().isoformat(timespec='seconds')} [{RUN_ID}] {message}"
    print(line, file=sys.stderr, flush=True)
    with open(LOG_FILE, "a", encoding="utf-8") as log_file:
        print(line, file=log_file)


def random_location() -> Coord:
    return round(random.uniform(-60, 70), 2), round(random.uniform(-180, 180), 2)


def candidate_locations() -> Iterator[Candidate]:
    seen: set[Coord] = set()
    fallback: list[Coord] = list(LOCATIONS)
    random.shuffle(fallback)
    log(f"candidate_pools random={MAX_RETRIES} curated={len(fallback)}")
    for _ in range(MAX_RETRIES):
        lat, lon = random_location()
        if (lat, lon) in seen:
            continue
        seen.add((lat, lon))
        yield lat, lon, "random"
    for lat, lon in fallback:
        key = (round(lat, 2), round(lon, 2))
        if key in seen:
            continue
        seen.add(key)
        yield lat, lon, "curated"


def reverse_geocode(lat: float, lon: float) -> str | None:
    try:
        url = f"https://nominatim.openstreetmap.org/reverse?lat={lat}&lon={lon}&format=json&zoom=6&accept-language=en"
        req = urllib.request.Request(url, headers={"User-Agent": "wallpaper-gen/1.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
        addr = data.get("address", {})
        name = addr.get("region") or addr.get("state_district") or addr.get("state") or addr.get("county") or addr.get("country")
        return name
    except Exception:
        return None


def get_resolution() -> tuple[int, int]:
    output: str = "1920x1080"
    if sys.platform == "darwin":
        try:
            output = subprocess.check_output(
                [
                    "osascript", "-l", "JavaScript", "-e",
                    'ObjC.import("AppKit");'
                    "var s = $.NSScreen.mainScreen, f = s.frame;"
                    'Math.round(f.size.width * s.backingScaleFactor) + "x"'
                    " + Math.round(f.size.height * s.backingScaleFactor);",
                ],
                text=True,
            ).strip()
        except Exception:
            pass
    elif "WAYLAND_DISPLAY" in os.environ:
        try:
            output = subprocess.check_output(
                "hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .width, .height' | paste -sd x -",
                shell=True,
            ).decode().strip()
        except Exception:
            pass
    return tuple(map(int, output.split("x")))


def lat_lon_to_tile(lat: float, lon: float, zoom: int) -> tuple[int, int]:
    n = 2 ** zoom
    x = int(n * ((lon + 180) / 360))
    lat_rad = math.radians(lat)
    y = int(n * (1 - (math.log(math.tan(lat_rad) + 1 / math.cos(lat_rad)) / math.pi)) / 2)
    return x, y


def fetch_tile(z: int, x: int, y: int) -> Image.Image:
    url = TILE_URL.format(z=z, x=x, y=y)
    req = urllib.request.Request(url, headers={"User-Agent": "wallpaper-gen/1.0"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return Image.open(BytesIO(resp.read()))


def fetch_terrain(lat: float, lon: float, tiles_x: int, tiles_y: int, zoom: int) -> tuple[Image.Image, bool]:
    cx, cy = lat_lon_to_tile(lat, lon, zoom)
    sx, sy = cx - tiles_x // 2, cy - tiles_y // 2
    tag = f"z{zoom}_x{sx}_y{sy}_{tiles_x}x{tiles_y}"
    cache_file = os.path.join(CACHE, f"terrain_{tag}.png")
    if os.path.exists(cache_file):
        return Image.open(cache_file), True
    full = Image.new("RGB", (tiles_x * TILE_SIZE, tiles_y * TILE_SIZE))
    for ty in range(tiles_y):
        for tx in range(tiles_x):
            tile = fetch_tile(zoom, sx + tx, sy + ty)
            full.paste(tile, (tx * TILE_SIZE, ty * TILE_SIZE))
    full.save(cache_file)
    return full, False


def decode_terrarium(img: Image.Image) -> tuple[Image.Image, int, float]:
    raw_bytes = img.tobytes()
    px_count = len(raw_bytes) // 3
    raw: list[int] = [0] * px_count
    land: int = 0
    for i in range(px_count):
        off = i * 3
        raw[i] = (raw_bytes[off] << 8) | raw_bytes[off + 1]
        if raw[i] > SEA_LEVEL:
            land += 1
    lo, hi = min(raw), max(raw)
    rng = hi - lo or 1
    norm = bytearray((e - lo) * 255 // rng for e in raw)
    return Image.frombytes("L", img.size, bytes(norm)), hi - lo, land / px_count


def build_contour_mask(elevation: Image.Image, W: int, H: int) -> Image.Image:
    S: int = 2
    iW, iH = W * S, H * S
    terrain = elevation.resize((iW, iH), Image.BICUBIC)
    terrain = terrain.filter(ImageFilter.GaussianBlur(radius=15 * S))
    step = max(1, 256 // CONTOUR_LEVELS)
    terrain = terrain.point(lambda p: (p // step) * step)
    eroded = terrain.filter(ImageFilter.MinFilter(3))
    edges = ImageChops.subtract(terrain, eroded)
    edges = edges.point(lambda p: 255 if p > 0 else 0)
    edges = edges.filter(ImageFilter.MaxFilter(3))
    edges = edges.filter(ImageFilter.GaussianBlur(radius=1.5 * S))
    return edges.point(lambda p: 255 if p > 80 else 0)


def contour_stats(elevation: Image.Image) -> ContourMetrics:
    mask = build_contour_mask(elevation, PREVIEW_W, PREVIEW_H).resize((PREVIEW_W, PREVIEW_H), Image.NEAREST)
    mask_bytes = mask.tobytes()
    total: int = len(mask_bytes)
    filled: int = 0
    cell_counts: list[int] = [0] * (GRID_COLS * GRID_ROWS)
    for y in range(PREVIEW_H):
        row_off = y * PREVIEW_W
        cy = y * GRID_ROWS // PREVIEW_H
        for x in range(PREVIEW_W):
            if mask_bytes[row_off + x]:
                filled += 1
                cx = x * GRID_COLS // PREVIEW_W
                cell_counts[cy * GRID_COLS + cx] += 1
    coverage = filled / total
    occupied = sum(1 for count in cell_counts if count)
    largest_share = max(cell_counts) / filled if filled else 1
    return coverage, occupied, largest_share


def candidate_summary(elevation: Image.Image, relief: int, land_fraction: float) -> tuple[bool, str]:
    if relief < MIN_RELIEF or land_fraction < MIN_LAND_FRACTION:
        return False, (
            f"relief={relief} land_fraction={land_fraction:.3f} "
            f"thresholds=({MIN_RELIEF},{MIN_LAND_FRACTION:.3f})"
        )
    coverage, occupied, largest_share = contour_stats(elevation)
    ok = coverage >= MIN_CONTOUR_COVERAGE and occupied >= MIN_OCCUPIED_CELLS and largest_share <= MAX_CELL_SHARE
    return ok, (
        f"relief={relief} land_fraction={land_fraction:.3f} "
        f"coverage={coverage:.3f} occupied={occupied} largest_cell_share={largest_share:.3f} "
        f"thresholds=({MIN_CONTOUR_COVERAGE:.3f},{MIN_OCCUPIED_CELLS},{MAX_CELL_SHARE:.3f})"
    )


def render_contours(elevation: Image.Image, W: int, H: int, bg: Rgb, line_color: Rgb) -> Image.Image:
    S: int = 2
    iW, iH = W * S, H * S
    edges = build_contour_mask(elevation, W, H)
    bg_img = Image.new("RGB", (iW, iH), bg)
    fg_img = Image.new("RGB", (iW, iH), line_color)
    img = Image.composite(fg_img, bg_img, edges)
    return img.resize((W, H), Image.LANCZOS)


def gen() -> None:
    W, H = get_resolution()
    tiles_x = math.ceil(W / TILE_SIZE)
    tiles_y = math.ceil(H / TILE_SIZE)
    theme = "midnight"
    try:
        with open(STATE) as f:
            theme = f.read().strip()
    except FileNotFoundError:
        theme = "midnight"
    if theme not in THEMES:
        theme = "midnight"
    log(f"start theme={theme} resolution={W}x{H} tiles={tiles_x}x{tiles_y} log={LOG_FILE}")
    for index, (lat, lon, source) in enumerate(candidate_locations(), start=1):
        log(f"candidate[{index}] source={source} lat={lat:.2f} lon={lon:.2f} begin")
        try:
            terrain_img, cache_hit = fetch_terrain(lat, lon, tiles_x, tiles_y, ZOOM)
        except Exception as err:
            log(f"candidate[{index}] source={source} lat={lat:.2f} lon={lon:.2f} fetch_error={err!r}")
            continue
        elevation, relief, land_fraction = decode_terrarium(terrain_img)
        ok, summary = candidate_summary(elevation, relief, land_fraction)
        status = "accept" if ok else "reject"
        cache = "hit" if cache_hit else "miss"
        log(f"candidate[{index}] source={source} lat={lat:.2f} lon={lon:.2f} cache={cache} {status} {summary}")
        if ok:
            break
    else:
        log("finish status=no_candidate")
        return
    elevation = elevation.crop((0, 0, min(elevation.width, W), min(elevation.height, H)))
    place = reverse_geocode(lat, lon)
    log(f"selected lat={lat:.2f} lon={lon:.2f} place={place or '<none>'}")
    coords = f"{lat:.2f}, {lon:.2f}"
    label = f"{place} ({coords})" if place else coords
    for theme_name, colors in THEMES.items():
        img = render_contours(elevation, W, H, colors["bg"], colors["line"])
        draw = ImageDraw.Draw(img)
        font = ImageFont.truetype(FONT, 21)
        draw.text((24, H - 38), label, fill=colors["label"], font=font)
        out_path = f"{DIR}/wallpaper-{theme_name}.jpg"
        img.save(out_path, quality=95)
        log(f"wrote theme={theme_name} path={out_path}")
    link = f"{DIR}/wallpaper.jpg"
    if os.path.lexists(link):
        os.unlink(link)
    target = f"{DIR}/wallpaper-{theme}.jpg"
    os.symlink(target, link)
    log(f"finish status=ok target={target} link={link}")


cmd: str | None = sys.argv[1] if len(sys.argv) > 1 else None
if cmd == "gen":
    gen()
else:
    print("Usage: ctl wallpaper gen", file=sys.stderr)
    sys.exit(1)
PYTHON
  nix-shell -p 'python3.withPackages (ps: [ ps.pillow ])' --run "python3 \"$_wp\" \"$2\""
  status=$?
  [ "$status" -eq 0 ] || exit "$status"
  case "$(uname)" in
  Linux)
    if systemctl --user is-active --quiet hyprpaper 2>/dev/null; then
      systemctl --user restart hyprpaper >/dev/null 2>&1 || true
    fi
    ;;
  Darwin)
    wp_theme="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/theme" 2>/dev/null)" || wp_theme=midnight
    [ -n "$wp_theme" ] || wp_theme=midnight
    theme "$wp_theme" >/dev/null 2>&1 || true
    ;;
  esac
  ;;
clip)
  require fuzzel cliphist wl-copy
  entries=$(cliphist list)
  [ -z "$entries" ] && exit 0
  count=$(printf '%s\n' "$entries" | wc -l)
  lines=$((count < 15 ? count : 15))
  sep=$(printf '\034')
  selected=$(printf '%s\n' "$entries" |
    awk -F'\t' -v sep="$sep" '{
      content = substr($0, index($0, "\t") + 1)
      display = (length(content) > 63) ? substr(content, 1, 60) "..." : content
      printf "       %s%s%s\n", display, sep, $0
    }' |
    fuzzel --dmenu --no-icons --prompt="clip:  " \
      --nth-delimiter="$sep" --with-nth=1 --accept-nth=2 \
      --font="Berkeley Mono:size=12" \
      --lines="$lines" --width=75)
  rc=$?
  [ "$rc" = 13 ] && {
    cliphist wipe
    exit 0
  }
  [ -n "$selected" ] || exit 0
  case $selected in
  *'[[ binary data '*' png '*) set -- --type image/png ;;
  *'[[ binary data '*' jpeg '*) set -- --type image/jpeg ;;
  *'[[ binary data '*' gif '*) set -- --type image/gif ;;
  *'[[ binary data '*) set -- ;;
  *) set -- --type text/plain ;;
  esac
  printf '%s\n' "$selected" | cliphist decode | wl-copy "$@"
  ;;
power)
  require fuzzel
  suspend="󰒲   Suspend"
  logout="󰍃   Logout"
  reboot="󰜉   Reboot"
  shutdown="󰐥   Shutdown"
  chosen="$(printf '%s\n' "$suspend" "$logout" "$reboot" "$shutdown" | fuzzel --dmenu --hide-prompt --lines=4 --width=20 --no-icons)"
  case "$chosen" in
  "$suspend") systemctl suspend ;;
  "$logout") hyprctl dispatch 'hl.dsp.exit()' ;;
  "$reboot") systemctl reboot ;;
  "$shutdown") systemctl poweroff ;;
  esac
  ;;
dictate)
  require pw-record curl wl-copy notify-send flock
  dtmp="${XDG_RUNTIME_DIR:-/tmp}/dictation"
  djobdir="$dtmp/jobs"
  mkdir -p "$dtmp" "$djobdir"
  dstate="$dtmp/active"
  dlock="$dtmp/lockfile"
  dhistory="$dtmp/history"
  dport=8178
  dictation_lock() {
    exec 9>"$dlock" || exit 1
    flock 9 || exit 1
  }
  dictation_unlock() {
    flock -u 9 2>/dev/null || true
    exec 9>&-
  }
  dictation_alive() {
    pid="$1"
    case "$pid" in
    '' | *[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    comm=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$comm" in
    pw-record | .pw-record-wrapped) return 0 ;;
    *) return 1 ;;
    esac
  }
  dictation_load_state() {
    active_session=
    active_pid=
    active_audio=
    [ -f "$dstate" ] || return 1
    {
      IFS= read -r active_session || return 1
      IFS= read -r active_pid || return 1
      IFS= read -r active_audio || active_audio=
    } <"$dstate"
    case "$active_session" in
    '' | */*) return 1 ;;
    esac
    case "$active_pid" in
    '' | *[!0-9]*) return 1 ;;
    esac
    [ -n "$active_audio" ]
  }
  dictation_save_state() {
    tmp="$dstate.tmp.$$"
    printf '%s\n%s\n%s\n' "$1" "$2" "$3" >"$tmp"
    mv "$tmp" "$dstate"
  }
  dictation_pending() {
    for job in "$djobdir"/*; do
      [ -e "$job" ] || continue
      return 0
    done
    return 1
  }
  dictation_schedule_idle_if_clear() {
    idle_delay="$1"
    dictation_lock
    case "$idle_delay" in
    success) idle_delay="$(whisper_idle_timeout "$dhistory")" ;;
    '' | *[!0-9]*) idle_delay=15 ;;
    esac
    if dictation_load_state; then
      if dictation_alive "$active_pid"; then
        dictation_unlock
        return 0
      fi
      rm -f "$dstate"
    fi
    if dictation_pending; then
      dictation_unlock
      return 0
    fi
    whisper_idle_schedule "$idle_delay"
    dictation_unlock
  }
  dictation_wait_for_stop() {
    stop_pid="$1"
    for _ in $(seq 1 50); do
      dictation_alive "$stop_pid" || return 0
      sleep 0.05
    done
    kill "$stop_pid" 2>/dev/null || true
    sleep 0.2
  }
  dictation_transcribe() {
    session="$1"
    stop_pid="$2"
    audio="$3"
    job="$djobdir/$session"
    (
      idle_delay=15
      trap 'rm -f "$job"; dictation_schedule_idle_if_clear "$idle_delay"' EXIT
      trap 'exit 1' HUP INT TERM
      dictation_wait_for_stop "$stop_pid"
      if [ ! -s "$audio" ]; then
        notify-send -a ctl -t 1250 "Dictation" "No audio"
        rm -f "$audio"
        exit 1
      fi
      notify-send -a ctl -t 1250 "Dictation" "Transcribing..."
      systemctl --user start whisper-dictation 2>/dev/null
      for _ in $(seq 1 50); do
        curl -s --max-time 1 "http://127.0.0.1:$dport/" >/dev/null 2>&1 && break
        sleep 0.1
      done
      text=$(curl -sf --max-time 60 "http://127.0.0.1:$dport/inference" \
        -F "file=@$audio" \
        -F "language=${DICTATE_LANG:-en}" \
        -F "response_format=text" 2>/dev/null | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr -s ' ')
      rm -f "$audio"
      if [ -z "$text" ]; then
        notify-send -a ctl -t 1250 "Dictation" "No speech detected"
        exit 1
      fi
      printf '%s' "$text" | wl-copy
      notify-send -a ctl -t 1250 "Dictation" "$text"
      idle_delay=success
    ) &
  }

  dictation_lock
  if dictation_load_state; then
    if dictation_alive "$active_pid"; then
      stop_session="$active_session"
      stop_pid="$active_pid"
      stop_audio="$active_audio"
      rm -f "$dstate"
      : >"$djobdir/$stop_session"
      dictation_unlock
      kill -INT "$stop_pid" 2>/dev/null || kill "$stop_pid" 2>/dev/null || true
      dictation_transcribe "$stop_session" "$stop_pid" "$stop_audio"
      exit 0
    fi
    rm -f "$dstate"
  fi

  session="$(date +%s%N)-$$"
  audio="$dtmp/$session.wav"
  whisper_idle_cancel
  systemctl --user start whisper-dictation 2>/dev/null
  notify-send -a ctl -t 1250 "Dictation" "Recording..."
  pw-record "$audio" &
  dictation_save_state "$session" "$!" "$audio"
  dictation_unlock
  ;;
grayscale)
  case "${2:-toggle}" in
  toggle)
    require notify-send
    if [ "$(grayscale_read_state)" = on ]; then
      grayscale_off
      notify-send -a ctl -t 2500 "Grayscale" "Off"
    else
      grayscale_on
      notify-send -a ctl -t 2500 "Grayscale" "On"
    fi
    ;;
  on)
    grayscale_on
    ;;
  off)
    grayscale_off
    ;;
  state)
    grayscale_read_state
    ;;
  *)
    echo "Usage: ctl grayscale [toggle|state|on|off]" >&2
    exit 1
    ;;
  esac
  ;;
*)
  echo "Usage: ctl {screenshot|keyboard|audio|wifi|brightness|volume|media|wallpaper|power|grayscale|clip|dictate}" >&2
  exit 1
  ;;
esac
