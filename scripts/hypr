#!/bin/sh

require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "hypr: missing dependency: $cmd" >&2
      exit 1
    }
  done
}

app_class() {
  case "$1" in
  google-chrome | google-chrome-stable) printf '%s\n' "google-chrome" ;;
  chromium) printf '%s\n' "Chromium" ;;
  zen | zen-browser) printf '%s\n' "zen" ;;
  firefox) printf '%s\n' "firefox" ;;
  alacritty) printf '%s\n' "Alacritty" ;;
  code | vscodium) printf '%s\n' "Code" ;;
  signal-desktop | signal) printf '%s\n' "signal" ;;
  telegram-desktop | telegram) printf '%s\n' "org.telegram.desktop" ;;
  ghostty) printf '%s\n' "com.mitchellh.ghostty" ;;
  bitwarden-desktop | bitwarden) printf '%s\n' "Bitwarden" ;;
  slack) printf '%s\n' "Slack" ;;
  discord) printf '%s\n' "discord" ;;
  vesktop) printf '%s\n' "vesktop" ;;
  element-desktop | element) printf '%s\n' "electron" ;;
  *) printf '%s\n' "$1" ;;
  esac
}

client_rows() {
  hyprctl -j clients 2>/dev/null | jq -r --arg class "$1" '
    .[]? | select(
      ((.xdgTag // "") | ascii_downcase | contains($class | ascii_downcase)) or
      ((.initialClass // "") | ascii_downcase | contains($class | ascii_downcase)) or
      ((.class // "") | ascii_downcase | contains($class | ascii_downcase))
    ) | "\(.class)\t\(.title // "no title")\t\(.address)"
  '
}

active_workspace_id() {
  hyprctl activeworkspace -j | jq -r '.id'
}

window_workspace_id() {
  hyprctl clients -j | jq -r --arg addr "$1" '.[] | select(.address == $addr) | .workspace.id'
}

quote_arg() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

build_exec_command() {
  CMD=$(quote_arg "$1")
  shift
  for arg in "$@"; do
    CMD="$CMD $(quote_arg "$arg")"
  done
  printf '%s\n' "$CMD"
}

usage() {
  cat <<EOF
Usage: hypr <subcommand> [app] [args...]

Commands:
  spawnfocus <app> [args...]    Focus existing window or spawn app with args
  pull [app]                    Pull window to current workspace (picker if no app)
  exit                          Safely exit hyprland

Options:
  -h, --help                    Show this help message
EOF
}

[ -z "$1" ] && {
  usage
  exit 1
}

cmd="$1"
shift

case "$cmd" in
-h | --help)
  usage
  exit 0
  ;;
exit)
  require hyprctl
  pkill hypridle
  pkill hyprpaper
  hyprctl dispatch exit
  exit 0
  ;;
pull)
  require hyprctl jq fuzzel
  APP="$1"
  CLASS=$(app_class "$APP")

  CUR_WS=$(active_workspace_id)
  CUR_ADDR=$(hyprctl -j activewindow | jq -r '.address // empty')
  WIN_ADDRS=$(client_rows "$CLASS")
  WIN_COUNT=$(printf '%s\n' "$WIN_ADDRS" | grep -c . || :)

  if [ "$WIN_COUNT" -eq 0 ]; then
    exit 0
  fi

  if [ "$WIN_COUNT" -eq 1 ]; then
    WIN_ADDR=$(printf '%s\n' "$WIN_ADDRS" | awk -F'\t' '{print $3}')
  else
    ROFI_LINES=$(
      printf '%s\n' "$WIN_ADDRS" |
        awk -F'\t' -v cur="$CUR_ADDR" '
        $3 != cur { printf "%s : %s\t%s\n", $1, $2, $3 }
      '
    )

    [ -z "$ROFI_LINES" ] && exit 0

    SELECTED=$(printf '%s\n' "$ROFI_LINES" | fuzzel --dmenu --prompt="pull:  ")

    [ -z "$SELECTED" ] && exit 0

    WIN_ADDR=$(printf '%s\n' "$SELECTED" | awk -F'\t' '{print $2}')
  fi

  [ -z "$WIN_ADDR" ] && exit 0

  hyprctl dispatch movetoworkspace "${CUR_WS},address:${WIN_ADDR}"
  hyprctl dispatch focuswindow "address:${WIN_ADDR}"
  ;;
spawnfocus)
  require hyprctl jq fuzzel socat
  WS=""
  while [ $# -gt 0 ]; do
    case "$1" in
    --ws)
      if [ $# -lt 2 ]; then
        echo "Missing workspace number after --ws"
        exit 1
      fi
      WS="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option $1"
      exit 1
      ;;
    *)
      break
      ;;
    esac
  done

  APP="$1"
  [ -z "$APP" ] && {
    echo 'Specify an app'
    exit 1
  }
  shift

  CLASS=$(app_class "$APP")
  WIN_ADDRS=$(client_rows "$CLASS")
  WIN_COUNT=$(printf '%s\n' "$WIN_ADDRS" | grep -c . || :)

  if [ "$WIN_COUNT" -eq 0 ]; then
    WIN_ADDR=""
  elif [ "$WIN_COUNT" -eq 1 ]; then
    WIN_ADDR=$(printf '%s\n' "$WIN_ADDRS" | awk -F'\t' '{print $3}')
  else
    SELECTED=$(printf '%s\n' "$WIN_ADDRS" | awk -F'\t' '{print $1 ": " $2 "\t" $3}' | fuzzel --dmenu --prompt="window:  ")

    if [ -z "$SELECTED" ]; then
      exit 0
    fi

    WIN_ADDR=$(printf '%s\n' "$SELECTED" | awk -F'\t' '{print $2}')
  fi

  if [ -n "$WIN_ADDR" ]; then
    if [ -n "$WS" ]; then
      WIN_WS=$(window_workspace_id "$WIN_ADDR")

      if [ "$WIN_WS" != "$WS" ]; then
        hyprctl dispatch movetoworkspacesilent "$WS,address:$WIN_ADDR"
      fi

      hyprctl dispatch workspace "$WS"
    else
      WIN_WS=$(window_workspace_id "$WIN_ADDR")
      hyprctl dispatch workspace "$WIN_WS"
    fi

    hyprctl dispatch focuswindow "address:$WIN_ADDR"
  else
    EXISTING_HEX=$(printf '%s\n' "$WIN_ADDRS" | awk -F'\t' 'NF { sub(/^0x/, "", $3); printf "%s ", $3 }')

    if [ -n "$WS" ]; then
      hyprctl dispatch workspace "$WS"
      LAUNCH_CMD=$(build_exec_command "$APP" "$@")
      hyprctl dispatch exec "[workspace $WS silent; no_initial_focus] $LAUNCH_CMD"
    elif [ $# -eq 0 ]; then
      "$APP" &
    else
      "$APP" "$@" &
    fi

    socat -u UNIX-CONNECT:"$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" - 2>/dev/null | while IFS= read -r line; do
      case "$line" in
      openwindow*)
        window_id=$(echo "$line" | cut -d'>' -f3 | cut -d',' -f1)
        event_class=$(echo "$line" | cut -d'>' -f3 | cut -d',' -f3)
        class_lower=$(echo "$event_class" | tr '[:upper:]' '[:lower:]')
        target_lower=$(echo "$CLASS" | tr '[:upper:]' '[:lower:]')
        case "$class_lower" in
        *"$target_lower"*)
          case " $EXISTING_HEX " in
          *" $window_id "*) ;;
          *)
            addr="0x$window_id"
            if [ -n "$WS" ]; then
              WIN_WS=$(window_workspace_id "$addr")
              if [ "$WIN_WS" != "$WS" ]; then
                hyprctl dispatch movetoworkspacesilent "$WS,address:$addr"
              fi
              CUR_WS=$(active_workspace_id)
              if [ "$CUR_WS" = "$WS" ]; then
                hyprctl dispatch focuswindow "address:$addr"
              fi
            else
              hyprctl dispatch focuswindow "address:$addr"
            fi
            break
            ;;
          esac
          ;;
        esac
        ;;
      esac
    done
  fi
  ;;
*)
  echo "Unknown subcommand: $cmd"
  usage
  exit 1
  ;;
esac
