#!/bin/sh

require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "theme: missing dependency: $cmd" >&2
      exit 1
    }
  done
}

require dconf

themes="daylight
midnight"

if [ -n "$1" ]; then
  theme="$1"
else
  current="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/theme" 2>/dev/null)"
  case "$current" in
  midnight) theme="daylight" ;;
  *) theme="midnight" ;;
  esac
fi

[ -z "$theme" ] && exit 1
echo "$themes" | grep -Fxq "$theme" || exit 1

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir"
printf '%s\n' "$theme" >"$state_dir/theme"
export THEME="$theme"

case "$(uname)" in
Linux)
  case "$theme" in
  midnight) dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'" ;;
  daylight) dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'" ;;
  esac

  if command -v hyprctl >/dev/null 2>&1 && hyprctl monitors >/dev/null 2>&1; then
    case "$theme" in
    midnight)
      hyprctl keyword general:col.active_border "rgb(e0e0e0)"
      hyprctl keyword general:col.inactive_border "rgb(121212)"
      ;;
    daylight)
      hyprctl keyword general:col.active_border "rgb(1a1a1a)"
      hyprctl keyword general:col.inactive_border "rgb(f5f5f5)"
      ;;
    esac

    cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

    waybar_themes="$cfg/waybar/themes"
    [ -f "$waybar_themes/$theme.css" ] && ln -sf "$waybar_themes/$theme.css" "$waybar_themes/theme.css"

    hypr_themes="$cfg/hypr/themes"
    [ -f "$hypr_themes/$theme.conf" ] && {
      ln -sf "$hypr_themes/$theme.conf" "$hypr_themes/theme.conf"
    }

    fzf_themes="$cfg/fzf/themes"
    [ -f "$fzf_themes/$theme" ] && {
      ln -sf "$fzf_themes/$theme" "$fzf_themes/theme"
    }

    fuzzel_themes="$cfg/fuzzel/themes"
    [ -f "$fuzzel_themes/$theme.ini" ] && {
      ln -sf "$fuzzel_themes/$theme.ini" "$fuzzel_themes/theme.ini"
    }

    dunst_themes="$cfg/dunst/themes"
    [ -f "$dunst_themes/$theme.conf" ] && {
      mkdir -p "$cfg/dunst/dunstrc.d"
      ln -sf "$dunst_themes/$theme.conf" "$cfg/dunst/dunstrc.d/theme.conf"
      dunstctl reload
    }

    zathura_themes="$cfg/zathura/themes"
    [ -f "$zathura_themes/$theme" ] && {
      ln -sf "$zathura_themes/$theme" "$cfg/zathura/theme"
      busctl --user list --acquired 2>/dev/null | awk '/org\.pwmt\.zathura\.PID-/{print $1}' | while read -r dest; do
        dbus-send --session --dest="$dest" --type=method_call \
          /org/pwmt/zathura org.pwmt.zathura.SourceConfig 2>/dev/null || true
      done
    }

    pics="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screensavers"
    themed_wp="$pics/wallpaper-$theme.jpg"
    [ -f "$themed_wp" ] && {
      ln -sf "$themed_wp" "$pics/wallpaper.jpg"
      systemctl --user restart hyprpaper
    }

  fi
  ;;
Darwin)
  case "$theme" in
  daylight) osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to false' 2>/dev/null || true ;;
  midnight) osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to true' 2>/dev/null || true ;;
  esac
  ;;
esac

if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux_themes="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/themes"
  [ -f "$tmux_themes/$theme.conf" ] && tmux source "$tmux_themes/$theme.conf"
  tmux setenv -g THEME "$theme"
fi

for socket in /run/user/"$(id -u)"/nvim.*.0 /tmp/nvim-*.sock; do
  [ -S "$socket" ] && nvim --server "$socket" --remote-expr "luaeval('require(\"config.fzf.reload\").reload()')" 2>/dev/null || true
done
