#!/bin/sh

require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "theme: missing dependency: $cmd" >&2
      exit 1
    }
  done
}

require dconf

apply_nvim_theme() {
  command -v nvim >/dev/null 2>&1 || return 0

  expr="execute('colorscheme $theme')"

  if [ -n "${NVIM:-}" ] && [ -S "$NVIM" ]; then
    nvim --server "$NVIM" --remote-expr "$expr" </dev/null >/dev/null 2>&1 &
  fi

  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mux"
  [ -d "$runtime_dir" ] || return 0

  for sock in "$runtime_dir"/*.sock; do
    [ -S "$sock" ] || continue
    [ "${NVIM:-}" = "$sock" ] && continue
    nvim --server "$sock" --remote-expr "$expr" </dev/null >/dev/null 2>&1 &
  done
}

themes="daylight
midnight"

if [ -n "$1" ]; then
  theme="$1"
else
  current="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/theme" 2>/dev/null)"
  case "$current" in
  midnight) theme="daylight" ;;
  *) theme="midnight" ;;
  esac
fi

[ -z "$theme" ] && exit 1
echo "$themes" | grep -Fxq "$theme" || exit 1

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir"
printf '%s\n' "$theme" >"$state_dir/theme"
export THEME="$theme"
apply_nvim_theme

case "$(uname)" in
Linux)
  case "$theme" in
  midnight) dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'" ;;
  daylight) dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'" ;;
  esac

  if command -v hyprctl >/dev/null 2>&1 && hyprctl monitors >/dev/null 2>&1; then
    case "$theme" in
    midnight)
      hyprctl keyword general:col.active_border "rgb(e0e0e0)" >/dev/null
      hyprctl keyword general:col.inactive_border "rgb(121212)" >/dev/null
      ;;
    daylight)
      hyprctl keyword general:col.active_border "rgb(1a1a1a)" >/dev/null
      hyprctl keyword general:col.inactive_border "rgb(f5f5f5)" >/dev/null
      ;;
    esac

    cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

    waybarctl apply-theme

    hypr_themes="$cfg/hypr/themes"
    [ -f "$hypr_themes/$theme.conf" ] && {
      ln -sf "$hypr_themes/$theme.conf" "$hypr_themes/theme.conf"
    }

    fzf_themes="$cfg/fzf/themes"
    [ -f "$fzf_themes/$theme" ] && {
      ln -sf "$fzf_themes/$theme" "$fzf_themes/theme"
    }

    fuzzel_themes="$cfg/fuzzel/themes"
    [ -f "$fuzzel_themes/$theme.ini" ] && {
      ln -sf "$fuzzel_themes/$theme.ini" "$fuzzel_themes/theme.ini"
    }

    dunst_themes="$cfg/dunst/themes"
    [ -f "$dunst_themes/$theme.conf" ] && {
      mkdir -p "$cfg/dunst/dunstrc.d"
      ln -sf "$dunst_themes/$theme.conf" "$cfg/dunst/dunstrc.d/theme.conf"
      dunstctl reload >/dev/null 2>&1 &
    }

    zathura_themes="$cfg/zathura/themes"
    [ -f "$zathura_themes/$theme" ] && {
      ln -sf "$zathura_themes/$theme" "$cfg/zathura/theme"
      (
        busctl --user list --acquired 2>/dev/null | awk '/org\.pwmt\.zathura\.PID-/{print $1}' | while read -r dest; do
          dbus-send --session --dest="$dest" --type=method_call \
            /org/pwmt/zathura org.pwmt.zathura.SourceConfig 2>/dev/null || true
        done
      ) &
    }

    pics="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screensavers"
    themed_wp="$pics/wallpaper-$theme.jpg"
    [ -f "$themed_wp" ] && {
      wp_link="$pics/wallpaper.jpg"
      current_wp="$(readlink -f "$wp_link" 2>/dev/null || true)"
      desired_wp="$(readlink -f "$themed_wp" 2>/dev/null || true)"
      if [ "$current_wp" != "$desired_wp" ]; then
        ln -sf "$themed_wp" "$wp_link"
        if systemctl --user is-active --quiet hyprpaper 2>/dev/null; then
          reload_lock="${XDG_RUNTIME_DIR:-/tmp}/theme-hyprpaper-reload"
          if mkdir "$reload_lock" 2>/dev/null; then
            (
              sleep 0.2
              systemctl --user is-active --quiet hyprpaper 2>/dev/null &&
                systemctl --user restart hyprpaper >/dev/null 2>&1
              rmdir "$reload_lock" 2>/dev/null || true
            ) &
          fi
        fi
      fi
    }

  fi
  ;;
Darwin)
  case "$theme" in
  daylight) osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to false' 2>/dev/null || true ;;
  midnight) osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to true' 2>/dev/null || true ;;
  esac
  ;;
esac
