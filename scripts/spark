#!/usr/bin/env python3

import hashlib
import os
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import NoReturn


DEFAULT_HOST = "spark"
DEFAULT_WORK_ROOT = ".cache/spark-builds"
DEFAULT_SLICE = "spark-build.slice"
DEFAULT_CPU_QUOTA = "400%"
DEFAULT_MEMORY_MAX = "24G"
DEFAULT_TASKS_MAX = "4096"
DEFAULT_JOBS = "2"
DEFAULT_PRUNE_DAYS = "7"
DEFAULT_PING_TIMEOUT = "15"
NVIM_LOCAL_ROOT = "/home/barrett/dev/neovim"
NVIM_REMOTE_ROOT = "dev/neovim"
NVIM_NIX_PACKAGES = [
    "nixpkgs#bash",
    "nixpkgs#gnumake",
    "nixpkgs#cmake",
    "nixpkgs#ninja",
    "nixpkgs#gettext",
    "nixpkgs#curl",
    "nixpkgs#git",
    "nixpkgs#gcc",
    "nixpkgs#pkg-config",
    "nixpkgs#unzip",
]

USAGE = """\
Usage:
  spark [options] <command> [args...]
  spark [options] -- <command> [args...]
  spark [options] --shell
  spark [options] ping
  spark [options] status
  spark [options] prune
  spark [options] clean
  spark [options] cleanup
  spark [options] nvim build <issue> [make-args...]
  spark [options] nvim deps <issue> [make-args...]
  spark [options] nvim test <issue> [test-file] [make-args...]
  spark [options] nvim run <issue> -- <command> [args...]
  spark [options] nvim shell <issue>
  spark [options] nvim clean <issue>

Options:
  -C, --repo <path>       Local repo/path to sync. Defaults to the git root.
  --slot <name>           Remote slot. Defaults to the local branch or default.
                          With --cleanup, an unset slot gets a unique suffix.
  --host <host>           SSH host. Defaults to SPARK_HOST or spark.
  --work-root <path>      Remote work root. Defaults to ~/.cache/spark-builds.
  --cpu-quota <quota>     Shared slice CPU quota. Defaults to 400%.
  --memory-max <size>     Shared slice memory ceiling. Defaults to 24G.
  --tasks-max <count>     Shared slice task ceiling. Defaults to 4096.
  -j, --jobs <count>      Build-tool parallelism. Defaults to 2.
  --no-sync               Reuse the remote copy without syncing first.
  --include-secrets       Do not hard-exclude secrets and .env files.
  --cleanup               Remove this repo/slot from Spark when the command exits.
  --shell                 Open an interactive shell in the remote copy.
  --prune-days <days>     Age threshold for prune. Defaults to 7.
  -y, --yes               Assume yes for cleanup confirmations.
  -h, --help              Show this help.

Environment:
  SPARK_PING_TIMEOUT      Seconds before ping gives up. Defaults to 15.

Neovim:
  <issue> is a numeric Neovim issue number.
  The local worktree is /home/barrett/dev/neovim/.worktrees/<issue>.
  The Spark mirror is ~/dev/neovim/.worktrees/<issue>.
  The local worktree is the source of truth; build/test/run/shell sync it first.
  clean and nvim clean prompt y/N unless -y/--yes is passed.
"""


class SparkError(Exception):
    pass


def die(message: str) -> NoReturn:
    raise SparkError(message)


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def quote(value: str) -> str:
    return shlex.quote(value)


def safe_name(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]", "-", value)


def short_hash(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()[:12]


def require(*commands: str) -> None:
    for command in commands:
        if shutil.which(command) is None:
            die(f"missing dependency: {command}")


def checked_run(
    args: list[str],
    *,
    capture: bool = False,
    stderr: int | None = None,
    timeout: int | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=stderr,
        timeout=timeout,
    )


@dataclass
class Spark:
    host: str = field(
        default_factory=lambda: os.environ.get("SPARK_HOST", DEFAULT_HOST)
    )
    work_root: str = field(
        default_factory=lambda: os.environ.get("SPARK_WORK_ROOT", DEFAULT_WORK_ROOT)
    )
    slice_name: str = field(
        default_factory=lambda: os.environ.get("SPARK_SLICE", DEFAULT_SLICE)
    )
    cpu_quota: str = field(
        default_factory=lambda: os.environ.get("SPARK_CPU_QUOTA", DEFAULT_CPU_QUOTA)
    )
    memory_max: str = field(
        default_factory=lambda: os.environ.get("SPARK_MEMORY_MAX", DEFAULT_MEMORY_MAX)
    )
    tasks_max: str = field(
        default_factory=lambda: os.environ.get("SPARK_TASKS_MAX", DEFAULT_TASKS_MAX)
    )
    jobs: str = field(
        default_factory=lambda: os.environ.get("SPARK_JOBS", DEFAULT_JOBS)
    )
    prune_days: str = field(
        default_factory=lambda: os.environ.get("SPARK_PRUNE_DAYS", DEFAULT_PRUNE_DAYS)
    )
    repo: str = ""
    slot: str = ""
    slot_set: bool = False
    nvim_issue: str = ""
    nvim_remote_dir_rel: str = ""
    nvim_local_worktree: str = ""
    sync: bool = True
    shell: bool = False
    include_secrets: bool = False
    cleanup: bool = False
    assume_yes: bool = False
    command_args: list[str] = field(default_factory=list)
    remote_home_dir: str = ""
    remote_root: str = ""
    remote_repo_dir: str = ""
    remote_dir: str = ""
    repo_name: str = ""
    repo_hash: str = ""

    def parse(self, argv: list[str]) -> list[str]:
        i = 0
        while i < len(argv):
            arg = argv[i]
            match arg:
                case "-C" | "--repo" | "--path":
                    self.repo = self.option_value(argv, i, arg)
                    i += 2
                case "--slot":
                    self.slot = self.option_value(argv, i, arg)
                    self.slot_set = True
                    i += 2
                case "--host":
                    self.host = self.option_value(argv, i, arg)
                    i += 2
                case "--work-root":
                    self.work_root = self.option_value(argv, i, arg)
                    i += 2
                case "--cpu-quota":
                    self.cpu_quota = self.option_value(argv, i, arg)
                    i += 2
                case "--memory-max":
                    self.memory_max = self.option_value(argv, i, arg)
                    i += 2
                case "--tasks-max":
                    self.tasks_max = self.option_value(argv, i, arg)
                    i += 2
                case "-j" | "--jobs":
                    self.jobs = self.option_value(argv, i, arg)
                    i += 2
                case "--prune-days":
                    self.prune_days = self.option_value(argv, i, arg)
                    i += 2
                case "--no-sync":
                    self.sync = False
                    i += 1
                case "--sync":
                    self.sync = True
                    i += 1
                case "--include-secrets":
                    self.include_secrets = True
                    i += 1
                case "--cleanup":
                    self.cleanup = True
                    i += 1
                case "-y" | "--yes":
                    self.assume_yes = True
                    i += 1
                case "--shell":
                    self.shell = True
                    i += 1
                case "-h" | "--help":
                    _ = sys.stderr.write(USAGE)
                    raise SystemExit(0)
                case "--":
                    return argv[i + 1 :]
                case _ if arg.startswith("-"):
                    die(f"unknown option: {arg}")
                case _:
                    return argv[i:]
        return []

    def option_value(self, argv: list[str], index: int, option: str) -> str:
        if index + 1 >= len(argv):
            die(f"{option} requires a value")
        return argv[index + 1]

    def dispatch(self, argv: list[str]) -> None:
        match argv:
            case ["ping", *rest]:
                self.no_extra_args("ping", rest)
                self.ping_host()
                return
            case ["status", *rest]:
                self.no_extra_args("status", rest)
                require("ssh")
                self.remote_home_dir = self.remote_home()
                self.remote_root = self.remote_path(self.work_root)
                self.show_status()
                return
            case ["prune", *rest]:
                self.no_extra_args("prune", rest)
                require("ssh")
                self.remote_home_dir = self.remote_home()
                self.remote_root = self.remote_path(self.work_root)
                _ = self.ssh(self.remote_prune_command())
                return
            case ["nvim", *rest]:
                if self.cleanup:
                    die(
                        "nvim commands do not support --cleanup; use spark nvim clean <issue>"
                    )
                self.apply_nvim_command(rest)
                argv = []
            case ["clean" | "cleanup", *rest]:
                self.parse_cleanup_flags(rest, "cleanup")
                self.command_args = ["clean"]
                argv = []
            case _:
                pass

        if not argv and not self.command_args and not self.shell:
            _ = sys.stderr.write(USAGE)
            raise SystemExit(1)

        if self.command_args != ["clean"] and not self.command_args:
            self.command_args = argv

        self.prepare_paths()
        cleanup_after_command = self.cleanup and self.command_args != ["clean"]

        try:
            if self.command_args == ["clean"]:
                self.confirm_clean_remote_dir()
                return

            if self.command_args == ["nvim-clean"]:
                self.confirm_clean_remote_dir()
                return

            if self.sync:
                self.sync_repo()

            self.mark_remote_used()

            if self.shell:
                self.open_shell()
                return

            if not self.command_args:
                _ = sys.stderr.write(USAGE)
                raise SystemExit(1)

            self.run_remote(self.command_args)
        finally:
            if cleanup_after_command:
                self.clean_remote_dir(check=False)

    def no_extra_args(self, command: str, args: list[str]) -> None:
        if args:
            die(f"{command} takes no extra arguments")

    def parse_cleanup_flags(self, args: list[str], command: str) -> None:
        for arg in args:
            if arg in ("-y", "--yes"):
                self.assume_yes = True
            else:
                die(f"{command} takes only optional -y/--yes")

    def normalize_issue(self, value: str) -> str:
        issue = value.removeprefix("#")
        if not issue or not issue.isdigit():
            die(f"expected numeric Neovim issue number, got: {value}")
        return issue

    def set_nvim_issue_paths(self, value: str) -> None:
        self.nvim_issue = self.normalize_issue(value)
        self.slot = self.nvim_issue
        self.slot_set = True
        self.nvim_remote_dir_rel = f"{NVIM_REMOTE_ROOT}/.worktrees/{self.nvim_issue}"
        self.nvim_local_worktree = f"{NVIM_LOCAL_ROOT}/.worktrees/{self.nvim_issue}"

    def require_nvim_local_worktree(self) -> None:
        if not Path(self.nvim_local_worktree).is_dir():
            die(f"missing local Neovim worktree: {self.nvim_local_worktree}")
        self.repo = self.nvim_local_worktree

    def nvim_make_command(self, make_args: list[str]) -> list[str]:
        return ["nix", "shell", *NVIM_NIX_PACKAGES, "--command", *make_args]

    def apply_nvim_command(self, args: list[str]) -> None:
        if not args:
            die("nvim requires build, deps, test, run, shell, or clean")

        match args:
            case []:
                die("nvim requires build, deps, test, run, shell, or clean")
            case ["build"]:
                die("nvim build requires an issue number")
            case ["build", issue, *make_args]:
                self.set_nvim_issue_paths(issue)
                self.require_nvim_local_worktree()
                self.command_args = self.nvim_make_command(
                    ["make", "CMAKE_BUILD_TYPE=RelWithDebInfo", *make_args]
                )
            case ["deps"]:
                die("nvim deps requires an issue number")
            case ["deps", issue, *make_args]:
                self.set_nvim_issue_paths(issue)
                self.require_nvim_local_worktree()
                self.command_args = self.nvim_make_command(["make", "deps", *make_args])
            case ["test"]:
                die("nvim test requires an issue number")
            case ["test", issue, *test_args]:
                self.set_nvim_issue_paths(issue)
                self.require_nvim_local_worktree()
                make_args = ["make", "functionaltest-lua"]
                if test_args:
                    make_args.append(f"TEST_FILE={test_args[0]}")
                    make_args.extend(test_args[1:])
                self.command_args = self.nvim_make_command(make_args)
            case ["run"]:
                die("nvim run requires an issue number")
            case ["run", issue, *run_args]:
                self.set_nvim_issue_paths(issue)
                self.require_nvim_local_worktree()
                if run_args and run_args[0] == "--":
                    run_args = run_args[1:]
                if not run_args:
                    die("nvim run requires a command")
                self.command_args = run_args
            case ["shell", issue]:
                self.shell = True
                self.set_nvim_issue_paths(issue)
                self.require_nvim_local_worktree()
            case ["shell", *_]:
                die("nvim shell takes only an issue number")
            case ["clean" | "cleanup"]:
                die("nvim clean requires an issue number")
            case ["clean" | "cleanup", issue, *flags]:
                self.set_nvim_issue_paths(issue)
                self.parse_cleanup_flags(flags, "nvim clean")
                self.repo = NVIM_LOCAL_ROOT
                self.sync = False
                self.command_args = ["nvim-clean"]
            case [command, *_]:
                die(f"unknown nvim command: {command}")
            case _:
                die("nvim requires build, deps, test, run, shell, or clean")

    def repo_root(self) -> str:
        if self.repo:
            path = Path(self.repo).expanduser()
            if not path.is_dir():
                die(f"not a directory: {self.repo}")
            return str(path.resolve())

        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode == 0 and (root := result.stdout.strip()):
            return str(Path(root).resolve())
        return str(Path.cwd().resolve())

    def branch_slot(self) -> str:
        result = subprocess.run(
            ["git", "-C", self.repo, "branch", "--show-current"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode == 0 and (branch := result.stdout.strip()):
            return safe_name(branch)
        return safe_name(Path(self.repo).name)

    def default_slot(self) -> str:
        base = self.branch_slot()
        if self.cleanup:
            return f"{base}-{short_hash(f'{self.repo}:{os.getpid()}:{time.time_ns()}')}"
        return base

    def prepare_paths(self) -> None:
        self.repo = self.repo_root()
        if not self.slot_set:
            self.slot = self.default_slot()
        self.repo_name = safe_name(Path(self.repo).name)
        self.slot = safe_name(self.slot)
        self.repo_hash = short_hash(self.repo)

        require("ssh")
        self.remote_home_dir = self.remote_home()
        self.remote_root = self.remote_path(self.work_root)
        if self.nvim_remote_dir_rel:
            self.remote_dir = self.remote_path(self.nvim_remote_dir_rel)
            self.remote_repo_dir = posixpath.dirname(self.remote_dir)
        else:
            self.remote_repo_dir = f"{self.remote_root}/worktrees/{self.repo_name}"
            self.remote_dir = f"{self.remote_repo_dir}/{self.slot}-{self.repo_hash}"

    def remote_home(self) -> str:
        result = checked_run(
            ["ssh", self.host, 'printf %s "$HOME"'],
            capture=True,
        )
        return result.stdout

    def remote_path(self, path: str) -> str:
        if path.startswith("/"):
            return path
        return posixpath.join(self.remote_home_dir, path)

    def ssh(
        self,
        remote_command: str,
        *,
        tty: bool = False,
        check: bool = True,
        capture: bool = False,
    ) -> subprocess.CompletedProcess[str]:
        args = ["ssh"]
        if tty:
            args.append("-t")
        args.extend([self.host, remote_command])
        if check:
            return checked_run(args, capture=capture)
        return subprocess.run(
            args,
            check=False,
            text=True,
            stdout=subprocess.PIPE if capture else None,
        )

    def configure_slice_command(self) -> str:
        return (
            "systemctl --user set-property --runtime "
            f"{quote(self.slice_name)} "
            f"CPUQuota={quote(self.cpu_quota)} "
            f"MemoryMax={quote(self.memory_max)} "
            f"TasksMax={quote(self.tasks_max)} >/dev/null"
        )

    def remote_prune_command(self) -> str:
        return "\n".join(
            [
                "set -eu",
                f"root={quote(self.remote_root)}",
                f"days={quote(self.prune_days)}",
                'mkdir -p "$root/worktrees" "$root/locks" "$root/meta"',
                " ".join(
                    [
                        'find "$root/worktrees"',
                        "-mindepth 2",
                        "-maxdepth 2",
                        "-type d",
                        '-mtime "+$days"',
                        "-exec rm -rf {} +",
                    ]
                ),
                " ".join(
                    [
                        'find "$root/worktrees"',
                        "-mindepth 1",
                        "-maxdepth 1",
                        "-type d",
                        "-empty",
                        "-delete",
                    ]
                ),
                " ".join(
                    [
                        'find "$root/locks" "$root/meta"',
                        "-type f",
                        '-mtime "+$days"',
                        "-delete 2>/dev/null || true",
                    ]
                ),
            ]
        )

    def remote_secret_cleanup_command(self) -> str:
        return "\n".join(
            [
                f"cd {quote(self.remote_dir)}",
                "rm -rf secrets .env",
                "find . \\",
                " ".join(
                    [
                        "  \\(",
                        "-type d -name secrets",
                        "-o -type f -name '.env'",
                        "-o -type f -name '.env.*'",
                        "-o -type f -name '*.pem'",
                        "-o -type f -name 'id_*'",
                        "\\) \\",
                    ]
                ),
                "  -prune -exec rm -rf {} +",
            ]
        )

    def sync_repo(self) -> None:
        require("rsync", "ssh")
        eprint(f"spark: syncing {self.repo} -> {self.host}:{self.remote_dir}")
        _ = self.ssh(f"mkdir -p {quote(self.remote_dir)}")

        rsync_args = [
            "rsync",
            "-az",
            "--delete",
            "--filter=:- .gitignore",
            "--filter=:- .sparkignore",
            "--filter=P /.deps/***",
            "--filter=H /.deps/***",
            "--filter=P /.direnv/***",
            "--filter=H /.direnv/***",
            "--filter=P /build/***",
            "--filter=H /build/***",
            "--filter=P /dist/***",
            "--filter=H /dist/***",
            "--filter=P /node_modules/***",
            "--filter=H /node_modules/***",
            "--filter=P /target/***",
            "--filter=H /target/***",
            "--exclude=/.git",
            "--exclude=/.git/",
            "--exclude=/result",
            "--exclude=/result-*",
        ]
        if not self.include_secrets:
            rsync_args.extend(
                [
                    "--exclude=/secrets/***",
                    "--exclude=/.env",
                    "--exclude=/.env.*",
                    "--exclude=**/secrets/***",
                    "--exclude=**/.env",
                    "--exclude=**/.env.*",
                    "--exclude=**/*.pem",
                    "--exclude=**/id_*",
                ]
            )

        _ = checked_run(
            [
                *rsync_args,
                f"{self.repo}/",
                f"{self.host}:{self.remote_dir}/",
            ]
        )
        if not self.include_secrets:
            _ = self.ssh(self.remote_secret_cleanup_command())

    def run_remote(self, args: list[str]) -> None:
        unit = f"spark-{safe_name(self.repo_name)}-{safe_name(self.slot)}-{os.getpid()}"
        quoted_args = " ".join(quote(arg) for arg in args)
        nix_config = f"max-jobs = 1\ncores = {self.jobs}\n"
        remote_command = "\n".join(
            [
                "set -eu",
                f"mkdir -p {quote(self.remote_root)}/locks {quote(self.remote_root)}/meta",
                self.configure_slice_command(),
                "systemd-run --user --pipe --wait --collect \\",
                f"  --slice={quote(self.slice_name)} \\",
                f"  --unit={quote(unit)} \\",
                f"  -E SPARK_LOCAL_ROOT={quote(self.repo)} \\",
                f"  -E SPARK_REMOTE_ROOT={quote(self.remote_dir)} \\",
                f"  -E MAKEFLAGS={quote(f'-j{self.jobs}')} \\",
                f"  -E CMAKE_BUILD_PARALLEL_LEVEL={quote(self.jobs)} \\",
                f"  -E NIX_BUILD_CORES={quote(self.jobs)} \\",
                f"  -E NIX_CONFIG={quote(nix_config)} \\",
                f"  -E XDG_CACHE_HOME={quote(f'{self.remote_dir}/.cache')} \\",
                f"  -E XDG_STATE_HOME={quote(f'{self.remote_dir}/.state')} \\",
                f"  -E XDG_DATA_HOME={quote(f'{self.remote_dir}/.local/share')} \\",
                f"  -E CARGO_HOME={quote(f'{self.remote_dir}/.cache/cargo')} \\",
                f"  -E npm_config_cache={quote(f'{self.remote_dir}/.cache/npm')} \\",
                f"  -E PIP_CACHE_DIR={quote(f'{self.remote_dir}/.cache/pip')} \\",
                f'  -- bash -lc \'cd "$SPARK_REMOTE_ROOT" && exec "$@"\' spark-command {quoted_args}',
            ]
        )
        eprint(f"spark: running in {self.host}:{self.remote_dir}")
        _ = self.ssh(remote_command)

    def clean_remote_dir(self, *, check: bool = True) -> None:
        if self.nvim_remote_dir_rel:
            _ = self.ssh(f"rm -rf {quote(self.remote_dir)}", check=check)
            return

        command = (
            "cleanup_status=0; "
            f"rm -rf {quote(self.remote_dir)} || cleanup_status=$?; "
            f"rmdir {quote(self.remote_repo_dir)} 2>/dev/null || true; "
            'exit "$cleanup_status"'
        )
        _ = self.ssh(command, check=check)

    def confirm_clean_remote_dir(self) -> None:
        eprint(f"spark: remote path: {self.host}:{self.remote_dir}")
        remote_command = "".join(
            [
                f"path={quote(self.remote_dir)}; ",
                '[ -e "$path" ] || { ',
                'printf "spark: missing remote path: %s\\n" "$path" >&2; ',
                "exit 2; ",
                "}; ",
                'du -sh "$path" 2>/dev/null || true',
            ]
        )
        _ = self.ssh(remote_command)
        if self.assume_yes:
            eprint("spark: cleanup confirmed by --yes")
            self.clean_remote_dir()
            return

        print(
            f"Remove Spark mirror {self.host}:{self.remote_dir}? y/N ",
            end="",
            file=sys.stderr,
            flush=True,
        )
        answer = sys.stdin.readline().rstrip("\n")
        if answer != "y":
            eprint("spark: cleanup cancelled")
            return
        self.clean_remote_dir()

    def open_shell(self) -> None:
        unit = (
            f"spark-{safe_name(self.repo_name)}-{safe_name(self.slot)}-shell-"
            f"{os.getpid()}"
        )
        nix_config = f"max-jobs = 1\ncores = {self.jobs}\n"
        remote_command = "\n".join(
            [
                "set -eu",
                self.configure_slice_command(),
                "systemd-run --user --pty --wait --collect \\",
                f"  --slice={quote(self.slice_name)} \\",
                f"  --unit={quote(unit)} \\",
                f"  -E SPARK_LOCAL_ROOT={quote(self.repo)} \\",
                f"  -E SPARK_REMOTE_ROOT={quote(self.remote_dir)} \\",
                f"  -E MAKEFLAGS={quote(f'-j{self.jobs}')} \\",
                f"  -E CMAKE_BUILD_PARALLEL_LEVEL={quote(self.jobs)} \\",
                f"  -E NIX_BUILD_CORES={quote(self.jobs)} \\",
                f"  -E NIX_CONFIG={quote(nix_config)} \\",
                f"  -E XDG_CACHE_HOME={quote(f'{self.remote_dir}/.cache')} \\",
                f"  -E XDG_STATE_HOME={quote(f'{self.remote_dir}/.state')} \\",
                f"  -E XDG_DATA_HOME={quote(f'{self.remote_dir}/.local/share')} \\",
                f"  -E CARGO_HOME={quote(f'{self.remote_dir}/.cache/cargo')} \\",
                f"  -E npm_config_cache={quote(f'{self.remote_dir}/.cache/npm')} \\",
                f"  -E PIP_CACHE_DIR={quote(f'{self.remote_dir}/.cache/pip')} \\",
                f"  --working-directory={quote(self.remote_dir)} \\",
                "  -- ${SHELL:-bash} -l",
            ]
        )
        eprint(f"spark: shell in {self.host}:{self.remote_dir}")
        _ = self.ssh(remote_command, tty=True)

    def show_status(self) -> None:
        remote_command = "\n".join(
            [
                "set -eu",
                "echo host=$(hostname)",
                "echo user=$(id -un)",
                " ".join(
                    [
                        "echo system=$(nix eval",
                        "--impure",
                        "--raw",
                        "--expr builtins.currentSystem",
                        "2>/dev/null || uname -m)",
                    ]
                ),
                "echo nproc=$(nproc)",
                "echo nproc_all=$(nproc --all)",
                "grep -E 'Cpus_allowed_list|Mems_allowed_list' /proc/self/status",
                "free -h",
                "df -h / /nix 2>/dev/null || df -h /",
                " ".join(
                    [
                        "systemctl show user-$(id -u).slice",
                        "-p CPUQuotaPerSecUSec",
                        "-p MemoryMax",
                        "-p ControlGroup",
                    ]
                ),
                " ".join(
                    [
                        "systemctl --user show",
                        quote(self.slice_name),
                        "-p ActiveState",
                        "-p CPUQuotaPerSecUSec",
                        "-p MemoryMax",
                        "-p TasksMax",
                        "-p ControlGroup",
                        "2>/dev/null || true",
                    ]
                ),
                " ".join(
                    [
                        "nvidia-smi",
                        "--query-gpu=name,driver_version,utilization.gpu,utilization.memory",
                        "--format=csv,noheader,nounits",
                        "2>/dev/null || true",
                    ]
                ),
                " ".join(
                    [
                        "systemctl --user --no-pager --plain list-units",
                        "'forgejo-runner-spark-nix-*.service'",
                        "2>/dev/null || true",
                    ]
                ),
                f"[ -d {quote(self.remote_root)} ] && du -sh {quote(self.remote_root)} || true",
            ]
        )
        _ = self.ssh(remote_command)

    def ping_host(self) -> None:
        require("ssh")
        timeout_value = os.environ.get("SPARK_PING_TIMEOUT", DEFAULT_PING_TIMEOUT)
        try:
            timeout_seconds = int(timeout_value)
        except ValueError:
            die(f"SPARK_PING_TIMEOUT must be an integer, got: {timeout_value}")

        remote_command = (
            'printf "spark: ok host=%s user=%s system=%s nproc=%s\\n" '
            '"$(hostname)" '
            '"$(id -un)" '
            '"$(nix eval --impure --raw --expr builtins.currentSystem '
            '2>/dev/null || uname -m)" '
            '"$(nproc)"'
        )
        eprint(f"spark: pinging {self.host}")
        _ = checked_run(
            [
                "ssh",
                "-o",
                "BatchMode=yes",
                "-o",
                f"ConnectTimeout={timeout_seconds}",
                self.host,
                remote_command,
            ],
            timeout=timeout_seconds,
        )

    def mark_remote_used(self) -> None:
        meta_dir = f"{self.remote_dir}/.spark-meta"
        last_used = f"{meta_dir}/last-used"
        _ = self.ssh(
            " && ".join(
                [
                    f"mkdir -p {quote(meta_dir)}",
                    f"date +%s > {quote(last_used)}",
                    f"touch {quote(self.remote_dir)}",
                ]
            )
        )


def main(argv: list[str]) -> int:
    spark = Spark()
    try:
        remaining = spark.parse(argv)
        spark.dispatch(remaining)
    except SystemExit as exc:
        if exc.code is None:
            return 0
        if isinstance(exc.code, int):
            return exc.code
        eprint(str(exc.code))
        return 1
    except SparkError as exc:
        eprint(f"spark: {exc}")
        return 1
    except subprocess.CalledProcessError as exc:
        return exc.returncode
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
