[commit]
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/nix/config/git/allowed_signers

[user]
	signingKey = ~/.ssh/id_ed25519.pub

[include]
	path = ~/.config/nix/config/git/aliases

[init]
	defaultBranch = main

[core]
	editor = nvim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	hooksPath = ~/.config/git/hooks

[color]
	ui = auto

[diff]
	tool = codediff

[difftool]
	prompt = false

[difftool "codediff"]
	cmd = nvim -c 'CodeDiff' $LOCAL $REMOTE

[merge]
	tool = diffs-nvim

[mergetool]
	prompt = false

[mergetool "codediff"]
	cmd = nvim -c 'CodeDiff' $LOCAL $REMOTE $MERGED

[mergetool "diffs-nvim"]
	cmd = nvim "$MERGED"

[push]
	autoSetupRemote = true

[credential]
	helper = cache

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
