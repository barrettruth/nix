#!/bin/sh
set -eu

zero_sha=0000000000000000000000000000000000000000
blocked=0
misattributed=0
known_identity_name='Barrett Ruth'
known_identity_emails='br@barrettruth.com
br.barrettruth@gmail.com
62671086+barrettruth@users.noreply.github.com'
own_author_emails=$(
  {
    git config --get-all user.email || true
    git config --get-all hooks.attributionAuthorEmail || true
    git config --get-all hooks.attribution-author-email || true
  } | sed '/^[[:space:]]*$/d'
)
own_author_name=$(git config user.name || true)

has_ai_tool_value() {
  if grep -Eiq '(^|[^[:alnum:]_])(anthropic|claude([[:space:]_.-]*code)?|devin([[:space:]_.-]*ai)?([[:space:]_.-]*integration)?|codex|openai|chatgpt|gpt([[:space:]_.-]*[[:alnum:]])?|copilot|github[[:space:]_.-]*copilot|cursor|windsurf|aider|sourcegraph[[:space:]_.-]*cody|cody|tabnine|codeium|qodo|mutable[[:space:]_.-]*ai|replit[[:space:]_.-]*agent|amazon[[:space:]_.-]*q|codewhisperer|gemini|google[[:space:]_.-]*gemini|duet[[:space:]_.-]*ai|ai[[:space:]_.-]*(assistant|agent|bot|model|tool))([^[:alnum:]_]|$)'; then
    return 0
  fi
  return 1
}

has_ai_trailer_key() {
  if grep -Eiq '^[[:space:]]*((ai|a\.i\.|artificial[[:space:]_.-]*intelligence)[[:space:]_.-]*(assisted|generated|authored|written|created|implemented)|(assistant|tool)[[:space:]_.-]*(assisted|generated|authored|written|created|implemented)|(generated|created|implemented|written|authored|assisted)[[:space:]_.-]*(by|with|using)[[:space:]_.-]*(ai|a\.i\.|artificial[[:space:]_.-]*intelligence|assistant|tool))[[:space:]]*:'; then
    return 0
  fi
  return 1
}

has_ai_body_phrase() {
  message=$1

  if printf '%s\n' "$message" | grep -Eiq '(^|[^[:alnum:]_])((ai|a\.i\.|artificial[[:space:]_.-]*intelligence)[[:space:]_.-]*(assisted|generated|authored|written|created|implemented)|(assistant|tool)[[:space:]_.-]*(assisted|generated|authored|written|created|implemented))([^[:alnum:]_]|$)'; then
    return 0
  fi

  if printf '%s\n' "$message" | grep -Eiq '(^|[^[:alnum:]_])(generated|created|implemented|written|authored|assisted)([[:space:]_.-]+(by|with|using))?[[:space:]:]+.*(anthropic|claude([[:space:]_.-]*code)?|devin([[:space:]_.-]*ai)?([[:space:]_.-]*integration)?|codex|openai|chatgpt|gpt|copilot|github[[:space:]_.-]*copilot|cursor|windsurf|aider|sourcegraph[[:space:]_.-]*cody|cody|tabnine|codeium|qodo|mutable[[:space:]_.-]*ai|replit[[:space:]_.-]*agent|amazon[[:space:]_.-]*q|codewhisperer|gemini|google[[:space:]_.-]*gemini|duet[[:space:]_.-]*ai|ai[[:space:]_.-]*(assistant|agent|bot|model|tool))([^[:alnum:]_]|$)'; then
    return 0
  fi
  return 1
}

has_forbidden_attribution() {
  message=$1
  trailers=$(printf '%s\n' "$message" | git interpret-trailers --parse)

  if [ -n "$trailers" ] && printf '%s\n' "$trailers" | has_ai_trailer_key; then
    return 0
  fi

  if [ -n "$trailers" ] && printf '%s\n' "$trailers" | sed 's/^[^:]*:[[:space:]]*//' | has_ai_tool_value; then
    return 0
  fi

  has_ai_body_phrase "$message"
}

is_own_commit() {
  commit=$1
  author_email=$(git log -1 --format=%ae "$commit")

  if [ -n "$own_author_emails" ]; then
    if printf '%s\n' "$own_author_emails" | grep -Fxiq "$author_email"; then
      return 0
    fi
    return 1
  fi

  if [ -n "$own_author_name" ]; then
    author_name=$(git log -1 --format=%an "$commit")
    if [ "$author_name" = "$own_author_name" ]; then
      return 0
    fi
    return 1
  fi

  return 0
}

identity_is_known() {
  printf '%s\n' "$known_identity_emails" | grep -Fxiq "$1"
}

has_foreign_identity() {
  commit=$1

  if [ "$(git log -1 --format=%an "$commit")" = "$known_identity_name" ] &&
    ! identity_is_known "$(git log -1 --format=%ae "$commit")"; then
    return 0
  fi

  if [ "$(git log -1 --format=%cn "$commit")" = "$known_identity_name" ] &&
    ! identity_is_known "$(git log -1 --format=%ce "$commit")"; then
    return 0
  fi

  return 1
}

# git lfs pre-push reads the same ref list from stdin, so it has to be buffered
# rather than consumed: draining it here left the lfs check a silent no-op.
refs=$(cat)

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes --tags 2>/dev/null || git rev-list "$local_sha")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for commit in $commits; do
    if has_foreign_identity "$commit"; then
      printf >&2 '%s\n' "Push blocked: commit $commit claims $known_identity_name via $(git log -1 --format='%ae / %ce' "$commit")."
      misattributed=1
    fi

    if ! is_own_commit "$commit"; then
      continue
    fi

    message=$(git log -1 --format=%B "$commit")
    if has_forbidden_attribution "$message"; then
      printf >&2 '%s\n' "Push blocked: commit $commit contains prohibited AI/tool attribution."
      blocked=1
    fi
  done
done <<REFS
$refs
REFS

if [ "$blocked" -ne 0 ]; then
  cat >&2 <<'EOF'

Remove prohibited attribution before pushing.
EOF
fi

if [ "$misattributed" -ne 0 ]; then
  cat >&2 <<'EOF'

Those commits carry your name under an address that is not yours. Find the
config that is setting it:
  git config --show-origin --get-all user.email
EOF
fi

if [ "$blocked" -ne 0 ] || [ "$misattributed" -ne 0 ]; then
  exit 1
fi

command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."
  exit 2
}
printf '%s\n' "$refs" | git lfs pre-push "$@"
