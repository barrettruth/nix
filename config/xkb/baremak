default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
  include "us(colemak_dh)"
  include "level3(switch)"

  key <AD01> { [ q, Q, exclam, exclam ] };
  key <AD02> { [ w, W, at, at ] };
  key <AD03> { [ f, F, numbersign, numbersign ] };
  key <AD04> { [ p, P, less, less ] };
  key <AD05> { [ b, B, slash, slash ] };
  key <AD06> { [ j, J, backslash, backslash ] };
  key <AD07> { [ l, L, greater, greater ] };
  key <AD08> { [ u, U, ampersand, ampersand ] };
  key <AD09> { [ y, Y, dollar, dollar ] };
  key <AD10> { [ semicolon, colon, bar, bar ] };

  key <AC01> { [ a, A, asciitilde, asciitilde ] };
  key <AC02> { [ r, R, equal, equal ] };
  key <AC03> { [ s, S, bracketleft, bracketleft ] };
  key <AC04> { [ t, T, braceleft, braceleft ] };
  key <AC05> { [ g, G, parenleft, parenleft ] };
  key <AC06> { [ m, M, parenright, parenright ] };
  key <AC07> { [ n, N, braceright, braceright ] };
  key <AC08> { [ e, E, bracketright, bracketright ] };
  key <AC09> { [ i, I, minus, minus ] };
  key <AC10> { [ o, O, plus, plus ] };
  key <AC11> { [ apostrophe, quotedbl, grave, grave ] };

  key <AB01> { [ z, Z, percent, percent ] };
  key <AB02> { [ x, X, asciicircum, asciicircum ] };
  key <AB03> { [ c, C, asterisk, asterisk ] };
  key <AB04> { [ d, D, underscore, underscore ] };
  key <AB05> { [ v, V, question, question ] };
  key <AB06> { [ k, K, colon, colon ] };
  key <AB07> { [ h, H, semicolon, semicolon ] };
  key <AB08> { [ comma, less, apostrophe, apostrophe ] };
  key <AB09> { [ period, greater, quotedbl, quotedbl ] };
};
