{
  "manifest_version": 3,
  "name": "Midnight",
  "key": "",
  "version": "1.0",
  "description": "Tab numbering, dark mode, and history search",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "debugger",
    "history"
  ],
  "host_permissions": ["<all_urls>"],
  "omnibox": {
    "keyword": "f"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["theme.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "css": ["linkedin.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "Command+Period"
      },
      "description": "Toggle history overlay"
    },
    "toggle-overlay-new-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle history overlay for new-tab opening"
    },
    "toggle-dark": {
      "description": "Toggle dark mode for current site"
    },
    "move-tab-left": {
      "description": "Move current tab left"
    },
    "move-tab-right": {
      "description": "Move current tab right"
    },
    "switch-workspace-1": {
      "description": "Switch to browser workspace 1"
    },
    "switch-workspace-2": {
      "description": "Switch to browser workspace 2"
    },
    "switch-workspace-3": {
      "description": "Switch to browser workspace 3"
    },
    "switch-workspace-4": {
      "description": "Switch to browser workspace 4"
    }
  }
}
