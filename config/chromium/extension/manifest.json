{
  "manifest_version": 3,
  "name": "Midnight",
  "key": "",
  "version": "1.0",
  "description": "Tab numbering, dark mode, themed new tab, and history search",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "debugger", "history"],
  "omnibox": {
    "keyword": "f"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["theme.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "Command+Period"
      },
      "description": "Toggle history overlay"
    },
    "toggle-overlay-new-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle history overlay for new-tab opening"
    },
    "toggle-dark": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Toggle dark mode for current site"
    }
  }
}
