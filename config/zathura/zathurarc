include theme

set font "Berkeley Mono 12"
set selection-clipboard clipboard
set recolor true
set synctex true
set synctex-editor-command "nvim --server /tmp/nvim-preview.sock --remote-expr \"execute('b +%{line} %{input}')\""
set window-title-basename true
set statusbar-home-tilde true
set adjust-open best-fit

map K scroll up
map J scroll down
map k scroll half-up
map j scroll half-down
map b toggle_statusbar
