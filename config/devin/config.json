{
  "agent": {
    "model": "claude-opus-5-xhigh-fast"
  },
  "read_config_from": {
    "cursor": false,
    "windsurf": false,
    "claude": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/nix/config/devin/hooks/repo-env.py\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^exec$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/nix/config/devin/hooks/repo-env.py\" command-not-found",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "shell": {
    "setup_complete": true
  },
  "show_hints": false,
  "theme_mode": "dark",
  "version": 1,
  "devin": {
    "org_id": "org-f27ebacf926a440d96985a94ab9b66bf"
  },
  "theme_auto_detect": "always"
}
