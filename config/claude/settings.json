{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "model": "claude-opus-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude/hooks/post-push.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel-plugin@vercel-vercel-plugin": true
  },
  "extraKnownMarketplaces": {
    "vercel-vercel-plugin": {
      "source": {
        "source": "directory",
        "path": "/home/barrett/.cache/plugins/github.com-vercel-vercel-plugin"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "notifications": {
    "hints": "disabled"
  },
  "network_access": true,
  "allowed_domains": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "tools": {
    "web_fetch": true
  }
}
