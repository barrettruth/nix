font-family = Iosevka Term
font-family-bold = Iosevka Term
font-family-italic = Iosevka Term
font-family-bold-italic = Iosevka Term
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-synthetic-style = false
font-codepoint-map = U+f101-U+f25c=nonicons
font-feature = -calt
font-size = 24
theme = dark:midnight,light:daylight
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor
window-decoration = false
window-padding-x = 0
window-padding-y = 0
window-padding-color = background
app-notifications = no-clipboard-copy,no-config-reload
gtk-single-instance = false
resize-overlay = never
mouse-scroll-multiplier = 0.5
quit-after-last-window-closed = true
confirm-close-surface = false
keybind = clear
keybind = alt+r=reload_config
keybind = alt+y=copy_to_clipboard
keybind = alt+p=paste_from_clipboard
keybind = alt+shift+h=decrease_font_size:1
keybind = alt+shift+l=increase_font_size:1
keybind = shift+enter=text:\n
