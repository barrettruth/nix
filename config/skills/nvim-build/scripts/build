#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'nvim-build: %s\n' "$*" >&2
  exit 1
}

[ "$#" -eq 0 ] || die "takes no arguments"

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git worktree"
[ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || die "not inside a git worktree"
[ -f "$root/Makefile" ] && [ -f "$root/BUILD.md" ] && [ -d "$root/cmake.deps" ] && [ -d "$root/src/nvim" ] || die "not a Neovim source checkout: $root"
command -v rbuild >/dev/null 2>&1 || die "rbuild is not on PATH"

state="${XDG_STATE_HOME:-$HOME/.local/state}/nvim-build"
mkdir -p "$state"
stamp="$(date +%Y%m%d-%H%M%S)"
log="$state/$stamp.log"
slot="nvim-build-$stamp-$$"

run_logged() {
  "$@" >>"$log" 2>&1
}

{
  printf 'nvim-build: root: %s\n' "$root"
  printf 'nvim-build: log: %s\n' "$log"
} | tee "$log"

cmd=(
  rbuild
  --cleanup
  -C "$root"
  --slot "$slot"
  --
  nix shell
  nixpkgs#bash
  nixpkgs#gnumake
  nixpkgs#cmake
  nixpkgs#ninja
  nixpkgs#gettext
  nixpkgs#curl
  nixpkgs#git
  nixpkgs#gcc
  nixpkgs#pkg-config
  nixpkgs#unzip
  --command make CMAKE_BUILD_TYPE=RelWithDebInfo
)

{
  printf 'nvim-build: command:'
  printf ' %q' "${cmd[@]}"
  printf '\n\n'
} >>"$log"

if ! run_logged rbuild ping; then
  printf 'nvim-build: rbuild connection failed\n' | tee -a "$log" >&2
  tail -n 80 "$log" >&2
  printf 'nvim-build: log: %s\n' "$log" >&2
  exit 1
fi

printf 'nvim-build: running on desktop\n'
if ! run_logged "${cmd[@]}"; then
  printf 'nvim-build: build failed\n' | tee -a "$log" >&2
  tail -n 80 "$log" >&2
  printf 'nvim-build: log: %s\n' "$log" >&2
  exit 1
fi

printf 'nvim-build: success\n' | tee -a "$log"
printf 'nvim-build: log: %s\n' "$log" >&2
